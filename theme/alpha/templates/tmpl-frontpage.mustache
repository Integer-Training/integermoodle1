    <script>
        // Character eye tracking
        (function() {
            var characters = document.getElementById('heroCharacters');
            if (!characters) return;

            var pupils = characters.querySelectorAll('.ep-pupil, .ep-pupil-only');
            var eyeballs = characters.querySelectorAll('.ep-eyeball');

            document.addEventListener('mousemove', function(e) {
                pupils.forEach(function(pupil) {
                    var rect = pupil.getBoundingClientRect();
                    var centerX = rect.left + rect.width / 2;
                    var centerY = rect.top + rect.height / 2;
                    var deltaX = e.clientX - centerX;
                    var deltaY = e.clientY - centerY;
                    var maxDist = pupil.classList.contains('ep-pupil-only') ? 5 : 4;
                    var dist = Math.min(Math.sqrt(deltaX * deltaX + deltaY * deltaY), maxDist * 20);
                    var angle = Math.atan2(deltaY, deltaX);
                    var x = Math.cos(angle) * Math.min(dist / 20, maxDist);
                    var y = Math.sin(angle) * Math.min(dist / 20, maxDist);
                    pupil.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
                });
            });

            // Blinking
            function scheduleBlink() {
                setTimeout(function() {
                    eyeballs.forEach(function(eye) { eye.classList.add('blinking'); });
                    setTimeout(function() {
                        eyeballs.forEach(function(eye) { eye.classList.remove('blinking'); });
                        scheduleBlink();
                    }, 150);
                }, Math.random() * 4000 + 3000);
            }
            scheduleBlink();
        })();

        // Quotes rotation
        (function() {
            var wrapper = document.getElementById('fpQuotesWrapper');
            var dotsContainer = document.getElementById('fpQuotesDots');
            if (!wrapper || !dotsContainer) return;

            var quotes = wrapper.querySelectorAll('.ep-quote-item');
            var currentIndex = 0;
            var interval;

            quotes.forEach(function(_, i) {
                var dot = document.createElement('span');
                dot.className = 'ep-quote-dot' + (i === 0 ? ' active' : '');
                dot.addEventListener('click', function() { goTo(i); });
                dotsContainer.appendChild(dot);
            });

            var dots = dotsContainer.querySelectorAll('.ep-quote-dot');

            function goTo(index) {
                quotes[currentIndex].classList.remove('active');
                dots[currentIndex].classList.remove('active');
                currentIndex = index;
                quotes[currentIndex].classList.add('active');
                dots[currentIndex].classList.add('active');
                resetInterval();
            }

            function next() { goTo((currentIndex + 1) % quotes.length); }

            function resetInterval() {
                clearInterval(interval);
                interval = setInterval(next, 6000);
            }

            interval = setInterval(next, 6000);

            wrapper.parentElement.addEventListener('mouseenter', function() { clearInterval(interval); });
            wrapper.parentElement.addEventListener('mouseleave', resetInterval);
        })();
    </script>

