<script>
(function() {
    // Set anchor
    var anchorEl = document.getElementById('anchor');
    if (anchorEl) anchorEl.value = location.hash;

    // State
    var mouseX = window.innerWidth / 2;
    var mouseY = window.innerHeight / 2;
    var isTyping = false;
    var isPasswordVisible = false;
    var passwordHasValue = false;

    // Elements
    var charPurple = document.getElementById('charPurple');
    var charBlack = document.getElementById('charBlack');
    var charOrange = document.getElementById('charOrange');
    var charYellow = document.getElementById('charYellow');
    var usernameInput = document.getElementById('username');
    var passwordInput = document.getElementById('password');
    var toggleBtn = document.getElementById('togglePassword');

    // Pupils
    var pupils = {
        purple: [document.getElementById('purplePupil1'), document.getElementById('purplePupil2')],
        black: [document.getElementById('blackPupil1'), document.getElementById('blackPupil2')],
        orange: [document.getElementById('orangePupil1'), document.getElementById('orangePupil2')],
        yellow: [document.getElementById('yellowPupil1'), document.getElementById('yellowPupil2')]
    };

    // Eyeballs for blinking
    var eyeballs = {
        purple: [document.getElementById('purpleEye1'), document.getElementById('purpleEye2')],
        black: [document.getElementById('blackEye1'), document.getElementById('blackEye2')]
    };

    // Mouse tracking
    document.addEventListener('mousemove', function(e) {
        mouseX = e.clientX;
        mouseY = e.clientY;
        if (!isTyping && !passwordHasValue) {
            updatePupils();
            updateCharacterLean();
        }
    });

    // Calculate pupil position
    function calculatePupilOffset(el, maxDist) {
        if (!el) return { x: 0, y: 0 };
        var rect = el.getBoundingClientRect();
        var centerX = rect.left + rect.width / 2;
        var centerY = rect.top + rect.height / 2;
        var deltaX = mouseX - centerX;
        var deltaY = mouseY - centerY;
        var dist = Math.min(Math.sqrt(deltaX * deltaX + deltaY * deltaY), maxDist * 20);
        var angle = Math.atan2(deltaY, deltaX);
        return {
            x: Math.cos(angle) * Math.min(dist / 20, maxDist),
            y: Math.sin(angle) * Math.min(dist / 20, maxDist)
        };
    }

    // Update all pupils
    function updatePupils() {
        Object.keys(pupils).forEach(function(char) {
            var maxDist = char === 'orange' || char === 'yellow' ? 5 : 4;
            pupils[char].forEach(function(pupil) {
                if (pupil) {
                    var offset = calculatePupilOffset(pupil, maxDist);
                    pupil.style.transform = 'translate(' + offset.x + 'px, ' + offset.y + 'px)';
                }
            });
        });
    }

    // Update character lean
    function updateCharacterLean() {
        if (!charPurple) return;
        var rect = charPurple.getBoundingClientRect();
        var centerX = rect.left + rect.width / 2;
        var deltaX = mouseX - centerX;
        var skew = Math.max(-6, Math.min(6, -deltaX / 120));

        if (charPurple && !charPurple.classList.contains('typing') && !charPurple.classList.contains('hiding')) {
            charPurple.style.transform = 'skewX(' + skew + 'deg)';
        }
        if (charBlack && !charBlack.classList.contains('typing') && !charBlack.classList.contains('hiding')) {
            charBlack.style.transform = 'skewX(' + skew + 'deg)';
        }
        if (charOrange && !charOrange.classList.contains('hiding')) {
            charOrange.style.transform = 'skewX(' + skew + 'deg)';
        }
        if (charYellow && !charYellow.classList.contains('hiding')) {
            charYellow.style.transform = 'skewX(' + skew + 'deg)';
        }
    }

    // Blinking animation
    function scheduleBlink(eyeballsArray) {
        var interval = Math.random() * 4000 + 3000;
        setTimeout(function() {
            eyeballsArray.forEach(function(eye) {
                if (eye) eye.classList.add('blinking');
            });
            setTimeout(function() {
                eyeballsArray.forEach(function(eye) {
                    if (eye) eye.classList.remove('blinking');
                });
                scheduleBlink(eyeballsArray);
            }, 150);
        }, interval);
    }

    scheduleBlink(eyeballs.purple);
    setTimeout(function() { scheduleBlink(eyeballs.black); }, 1500);

    // Set pupils to look at specific direction
    function setPupilsLook(x, y) {
        Object.keys(pupils).forEach(function(char) {
            pupils[char].forEach(function(pupil) {
                if (pupil) {
                    pupil.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
                }
            });
        });
    }

    // Typing state handlers
    function handleFocus() {
        isTyping = true;
        if (charPurple) charPurple.classList.add('typing');
        if (charBlack) charBlack.classList.add('typing');
        // Look at each other briefly
        setTimeout(function() {
            if (isTyping && !passwordHasValue) {
                updatePupils();
            }
        }, 800);
    }

    function handleBlur() {
        isTyping = false;
        if (!passwordHasValue) {
            if (charPurple) charPurple.classList.remove('typing');
            if (charBlack) charBlack.classList.remove('typing');
            updatePupils();
            updateCharacterLean();
        }
    }

    // Password visibility handling
    function handlePasswordChange() {
        passwordHasValue = passwordInput && passwordInput.value.length > 0;
        if (passwordHasValue && !isPasswordVisible) {
            // Characters look away (hiding)
            if (charPurple) { charPurple.classList.add('hiding'); charPurple.classList.remove('typing'); }
            if (charBlack) { charBlack.classList.add('hiding'); charBlack.classList.remove('typing'); }
            if (charOrange) charOrange.classList.add('hiding');
            if (charYellow) charYellow.classList.add('hiding');
            setPupilsLook(-4, -4);
        } else if (!passwordHasValue) {
            // Reset
            if (charPurple) charPurple.classList.remove('hiding');
            if (charBlack) charBlack.classList.remove('hiding');
            if (charOrange) charOrange.classList.remove('hiding');
            if (charYellow) charYellow.classList.remove('hiding');
            updatePupils();
        }
    }

    // Password toggle
    if (toggleBtn && passwordInput) {
        toggleBtn.addEventListener('click', function() {
            isPasswordVisible = !isPasswordVisible;
            passwordInput.setAttribute('type', isPasswordVisible ? 'text' : 'password');
            var eyeOpen = this.querySelector('.ep-eye-open');
            var eyeClosed = this.querySelector('.ep-eye-closed');
            if (eyeOpen && eyeClosed) {
                eyeOpen.style.display = isPasswordVisible ? 'none' : 'block';
                eyeClosed.style.display = isPasswordVisible ? 'block' : 'none';
            }
            // If password visible, characters can look normally
            if (isPasswordVisible && passwordHasValue) {
                if (charPurple) charPurple.classList.remove('hiding');
                if (charBlack) charBlack.classList.remove('hiding');
                if (charOrange) charOrange.classList.remove('hiding');
                if (charYellow) charYellow.classList.remove('hiding');
                updatePupils();
            } else if (passwordHasValue) {
                handlePasswordChange();
            }
        });
    }

    // Input event listeners
    if (usernameInput) {
        usernameInput.addEventListener('focus', handleFocus);
        usernameInput.addEventListener('blur', handleBlur);
    }

    if (passwordInput) {
        passwordInput.addEventListener('focus', handleFocus);
        passwordInput.addEventListener('blur', handleBlur);
        passwordInput.addEventListener('input', handlePasswordChange);
    }

    // Input glow effect
    document.querySelectorAll('.ep-input-wrapper').forEach(function(wrapper) {
        wrapper.addEventListener('mousemove', function(e) {
            var rect = this.getBoundingClientRect();
            var x = ((e.clientX - rect.left) / rect.width) * 100;
            var y = ((e.clientY - rect.top) / rect.height) * 100;
            this.style.setProperty('--mouse-x', x + '%');
            this.style.setProperty('--mouse-y', y + '%');
        });
    });

    // Autofocus
    if (usernameInput && usernameInput.value.length === 0) {
        usernameInput.focus();
    } else if (passwordInput) {
        passwordInput.focus();
    }

    // Initial state
    updatePupils();

    // === Quotes Rotation (handles both desktop and mobile) ===
    function initQuotes(containerSelector, dotsId) {
        var container = document.querySelector(containerSelector);
        if (!container) return;

        var quotes = container.querySelectorAll('.ep-quote');
        var dotsContainer = document.getElementById(dotsId);
        var currentIndex = 0;
        var interval;

        if (quotes.length === 0 || !dotsContainer) return;

        // Create dots
        quotes.forEach(function(_, i) {
            var dot = document.createElement('span');
            dot.className = 'ep-quote-dot' + (i === 0 ? ' active' : '');
            dot.addEventListener('click', function() { goTo(i); });
            dotsContainer.appendChild(dot);
        });

        var dots = dotsContainer.querySelectorAll('.ep-quote-dot');

        function goTo(index) {
            quotes[currentIndex].classList.remove('active');
            if (dots[currentIndex]) dots[currentIndex].classList.remove('active');
            currentIndex = index;
            quotes[currentIndex].classList.add('active');
            if (dots[currentIndex]) dots[currentIndex].classList.add('active');
            resetInterval();
        }

        function next() {
            goTo((currentIndex + 1) % quotes.length);
        }

        function resetInterval() {
            clearInterval(interval);
            interval = setInterval(next, 6000);
        }

        interval = setInterval(next, 6000);

        container.addEventListener('mouseenter', function() { clearInterval(interval); });
        container.addEventListener('mouseleave', resetInterval);
    }

    // Init both quote containers
    initQuotes('.ep-quotes', 'quoteDots');
    initQuotes('.ep-mobile-quotes', 'mobileQuoteDots');
})();
</script>

