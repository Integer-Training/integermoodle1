{{!
    @template local_admindashboard/admindash

    Admin Dashboard template for site administrators.
    Shows KPIs, charts, tutor performance, course overview, and alerts.

    @package   local_admindashboard
    @copyright 2025 Epearl Academy
    @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}

<div class="admindash-shell" id="admin-dashboard">

  <!-- ===== HEADER BAR ===== -->
  <div class="admindash-header">
    <div class="admindash-header-inner">
      <div>
        <h1 class="admindash-title">Admin Dashboard</h1>
        <p class="admindash-subtitle">Platform overview &middot; Epearl Academy</p>
      </div>
      <div class="admindash-header-actions">
        <a href="{{{learners_link}}}" class="admindash-hdr-btn">
          <i class="bi bi-people"></i> Learners
        </a>
        <a href="{{{tutors_link}}}" class="admindash-hdr-btn">
          <i class="bi bi-person-workspace"></i> Tutors
        </a>
        <a href="{{{marking_link}}}" class="admindash-hdr-btn">
          <i class="bi bi-journal-check"></i> Marking
        </a>
      </div>
    </div>
  </div>

  <!-- ===== SECTION 1: KPI CARDS ===== -->
  <div class="admindash-kpis">

    <a href="{{{learners_link}}}" class="admindash-kpi-link">
    <div class="admindash-kpi-card">
      <div class="admindash-kpi-top">
        <span class="admindash-kpi-icon admindash-kpi-icon--learners">
          <i class="bi bi-people-fill"></i>
        </span>
        <span class="admindash-kpi-label">Total Learners</span>
      </div>
      <div class="admindash-kpi-value">{{{total_learners}}}</div>
      <div class="admindash-kpi-chips">
        <span class="admindash-chip admindash-chip--green"><i class="bi bi-check-circle-fill"></i> {{{active_learners}}} Active</span>
        <span class="admindash-chip admindash-chip--slate"><i class="bi bi-pause-circle-fill"></i> {{{suspended_learners}}} Suspended</span>
      </div>
    </div>
    </a>

    <a href="{{{tutors_link}}}" class="admindash-kpi-link">
    <div class="admindash-kpi-card admindash-kpi-card--warm">
      <div class="admindash-kpi-top">
        <span class="admindash-kpi-icon admindash-kpi-icon--tutors">
          <i class="bi bi-person-workspace"></i>
        </span>
        <span class="admindash-kpi-label">Total Tutors</span>
      </div>
      <div class="admindash-kpi-value">{{{total_tutors}}}</div>
      <div class="admindash-kpi-chips">
        <span class="admindash-chip admindash-chip--amber"><i class="bi bi-diagram-3-fill"></i> Avg {{{avg_caseload}}} learners / tutor</span>
      </div>
    </div>
    </a>

    <a href="{{{courses_link}}}" class="admindash-kpi-link">
    <div class="admindash-kpi-card admindash-kpi-card--cool">
      <div class="admindash-kpi-top">
        <span class="admindash-kpi-icon admindash-kpi-icon--courses">
          <i class="bi bi-journal-bookmark-fill"></i>
        </span>
        <span class="admindash-kpi-label">Active Courses</span>
      </div>
      <div class="admindash-kpi-value">{{{total_courses}}}</div>
      <div class="admindash-kpi-chips">
        <span class="admindash-chip admindash-chip--link"><i class="bi bi-box-arrow-up-right"></i> View all courses</span>
      </div>
    </div>
    </a>

    <a href="{{{marking_link}}}" class="admindash-kpi-link">
    <div class="admindash-kpi-card admindash-kpi-card--deep">
      <div class="admindash-kpi-top">
        <span class="admindash-kpi-icon admindash-kpi-icon--marking">
          <i class="bi bi-clipboard2-check-fill"></i>
        </span>
        <span class="admindash-kpi-label">Awaiting Marking</span>
      </div>
      <div class="admindash-kpi-value">{{{global_awaiting}}}</div>
      <div class="admindash-kpi-chips">
        <span class="admindash-chip admindash-chip--red"><i class="bi bi-exclamation-triangle-fill"></i> {{{global_overdue}}} Overdue</span>
        <span class="admindash-chip admindash-chip--teal"><i class="bi bi-clock-fill"></i> {{{global_imminent}}} Due Soon</span>
      </div>
    </div>
    </a>

  </div>

  <!-- ===== SECTION 2: CHARTS ===== -->
  <div class="admindash-charts">

    <div class="admindash-chart-card">
      <div class="admindash-chart-hdr">
        <i class="bi bi-pie-chart-fill"></i>
        <span>Learner Status Distribution</span>
      </div>
      <div id="learnerPieChart" class="admindash-chart-body"></div>
    </div>

    <div class="admindash-chart-card">
      <div class="admindash-chart-hdr admindash-chart-hdr--alt">
        <i class="bi bi-bar-chart-line-fill"></i>
        <span>Monthly Enrollment Trend &middot; {{{currentyear}}}</span>
      </div>
      <div id="enrollmentChart" class="admindash-chart-body"></div>
    </div>

  </div>

  <!-- ===== SECTION 2B: ONLINE USERS ===== -->
  <div class="admindash-panel">
    <div class="admindash-panel-hdr admindash-panel-hdr--online">
      <div>
        <h3><i class="bi bi-broadcast"></i> Online Users <span class="admindash-online-badge">{{{online_count}}}</span></h3>
        <p>Users active in the last 5 minutes</p>
      </div>
      <div class="admindash-online-chips">
        <span class="admindash-chip admindash-chip--green"><i class="bi bi-mortarboard-fill"></i> {{{online_learner_count}}} Learners</span>
        <span class="admindash-chip admindash-chip--amber"><i class="bi bi-person-workspace"></i> {{{online_tutor_count}}} Tutors</span>
        <span class="admindash-chip admindash-chip--red"><i class="bi bi-shield-fill"></i> {{{online_admin_count}}} Admins</span>
      </div>
    </div>
    <div class="admindash-panel-body">
      {{#has_online_users}}
      <table id="onlineTable" class="admindash-table display" style="width:100%">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Last Active</th>
          </tr>
        </thead>
        <tbody>
          {{#online_users}}
          <tr>
            <td class="admindash-cell-name">{{{fullname}}}</td>
            <td class="admindash-cell-email">{{{email}}}</td>
            <td class="text-center">
              {{#is_admin}}<span class="admindash-pill admindash-pill--red">Admin</span>{{/is_admin}}
              {{#is_tutor}}<span class="admindash-pill admindash-pill--amber">Tutor</span>{{/is_tutor}}
              {{#is_learner}}<span class="admindash-pill admindash-pill--blue">Learner</span>{{/is_learner}}
            </td>
            <td class="text-center"><span class="admindash-online-time"><i class="bi bi-clock"></i> {{{time_ago}}}</span></td>
          </tr>
          {{/online_users}}
        </tbody>
      </table>
      {{/has_online_users}}
      {{^has_online_users}}
      <div class="admindash-empty-state">
        <i class="bi bi-wifi-off"></i>
        <p>No users are currently online</p>
      </div>
      {{/has_online_users}}
    </div>
  </div>

  <!-- ===== SECTION 3: TUTOR PERFORMANCE ===== -->
  <div class="admindash-panel">
    <div class="admindash-panel-hdr">
      <div>
        <h3><i class="bi bi-person-check-fill"></i> Tutor Performance</h3>
        <p>Assignment marking, caseloads, and turnaround metrics</p>
      </div>
    </div>
    <div class="admindash-panel-body">
      <table id="tutorTable" class="admindash-table display" style="width:100%">
        <thead>
          <tr>
            <th style="width:36px"></th>
            <th>Tutor Name</th>
            <th>Email</th>
            <th>Learners</th>
            <th>Awaiting Marking</th>
            <th>Inactive</th>
            <th>Avg Turn. (Days)</th>
            <th>Pass Rate</th>
          </tr>
        </thead>
        <tbody>
          {{#tutors}}
          <tr data-details="{{detail_json}}">
            <td class="admindash-toggle-cell"><span class="admindash-toggle-btn"><i class="bi bi-plus-circle"></i></span></td>
            <td class="admindash-cell-name">{{{fullname}}}</td>
            <td class="admindash-cell-email">{{{email}}}</td>
            <td class="text-center"><span class="admindash-pill admindash-pill--blue">{{{learner_count}}}</span></td>
            <td class="text-center">
              {{#has_overdue}}
                <span class="admindash-pill admindash-pill--red" title="Overdue (>72h)">{{{awaiting_overdue}}}</span>
              {{/has_overdue}}
              {{#has_ok}}
                <span class="admindash-pill admindash-pill--green" title="Within time (≤72h)">{{{awaiting_ok}}}</span>
              {{/has_ok}}
              {{^has_overdue}}{{^has_ok}}
                <span class="admindash-pill admindash-pill--green">0</span>
              {{/has_ok}}{{/has_overdue}}
            </td>
            <td class="text-center">
              {{#has_inactive}}
                <span class="admindash-pill admindash-pill--red">{{{inactive_count}}}</span>
              {{/has_inactive}}
              {{^has_inactive}}
                <span class="admindash-pill admindash-pill--green">0</span>
              {{/has_inactive}}
            </td>
            <td class="text-center">{{{avg_turnaround}}}</td>
            <td class="text-center"><strong>{{{pass_rate}}}</strong></td>
          </tr>
          {{/tutors}}
        </tbody>
      </table>
    </div>
  </div>

  <!-- ===== SECTION 4: COURSE OVERVIEW ===== -->
  <div class="admindash-panel">
    <div class="admindash-panel-hdr admindash-panel-hdr--alt">
      <div>
        <h3><i class="bi bi-journal-bookmark-fill"></i> Course Overview</h3>
        <p>Enrollment, activity, and completion metrics per course</p>
      </div>
    </div>
    <div class="admindash-panel-body">
      <table id="courseTable" class="admindash-table display" style="width:100%">
        <thead>
          <tr>
            <th>Course Name</th>
            <th>Enrolled</th>
            <th>Active (30d)</th>
            <th>Assignments</th>
            <th>Completion</th>
          </tr>
        </thead>
        <tbody>
          {{#courses}}
          <tr>
            <td class="admindash-cell-name">{{{coursename}}}</td>
            <td class="text-center">{{{enrolled}}}</td>
            <td class="text-center">{{{active_learners}}}</td>
            <td class="text-center">{{{assignments}}}</td>
            <td>
              <div class="admindash-completion">
                <div class="admindash-completion-bar">
                  <div class="admindash-completion-fill" style="width:{{{completion_pct}}}%"></div>
                </div>
                <span class="admindash-completion-text">{{{completion_rate}}}</span>
              </div>
            </td>
          </tr>
          {{/courses}}
        </tbody>
      </table>
    </div>
  </div>

  <!-- ===== SECTION 5: ALERT CARDS ===== -->
  <div class="admindash-alerts">

    <a href="{{{inactive_link}}}" class="admindash-alert admindash-alert--danger">
      <div class="admindash-alert-icon"><i class="bi bi-person-slash"></i></div>
      <div class="admindash-alert-content">
        <span class="admindash-alert-label">Inactive Learners (30+ days)</span>
        <span class="admindash-alert-value">{{{inactive_count}}}</span>
      </div>
      <i class="bi bi-arrow-right admindash-alert-arrow"></i>
    </a>

    <a href="{{{overdue_link}}}" class="admindash-alert admindash-alert--warning">
      <div class="admindash-alert-icon"><i class="bi bi-hourglass-bottom"></i></div>
      <div class="admindash-alert-content">
        <span class="admindash-alert-label">Overdue Assignments</span>
        <span class="admindash-alert-value">{{{overdue_count}}}</span>
      </div>
      <i class="bi bi-arrow-right admindash-alert-arrow"></i>
    </a>

    <a href="{{{imminent_link}}}" class="admindash-alert admindash-alert--info">
      <div class="admindash-alert-icon"><i class="bi bi-alarm"></i></div>
      <div class="admindash-alert-content">
        <span class="admindash-alert-label">Imminent Deadlines (3 days)</span>
        <span class="admindash-alert-value">{{{imminent_count}}}</span>
      </div>
      <i class="bi bi-arrow-right admindash-alert-arrow"></i>
    </a>

  </div>

</div>

<!-- ===== CDN: DataTables Buttons ===== -->
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css">
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/1.6.2/css/buttons.dataTables.min.css">
<script src="https://cdn.datatables.net/buttons/1.6.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/1.6.2/js/buttons.flash.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
<script src="https://cdn.datatables.net/buttons/1.6.2/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/1.6.2/js/buttons.print.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {

    // ===== HIGHCHARTS: Learner Status Pie =====
    Highcharts.chart('learnerPieChart', {
        chart: {
            type: 'pie',
            backgroundColor: 'transparent',
            style: { fontFamily: "'Libre Baskerville', Georgia, serif" }
        },
        title: { text: '' },
        tooltip: { pointFormat: '{series.name}: <b>{point.percentage:.1f}%</b> ({point.y})' },
        accessibility: { point: { valueSuffix: '%' } },
        plotOptions: {
            pie: {
                allowPointSelect: true,
                cursor: 'pointer',
                borderWidth: 2,
                borderColor: '#ffffff',
                dataLabels: {
                    enabled: true,
                    format: '<b>{point.name}</b>: {point.y}',
                    style: { fontSize: '12px', fontWeight: '400', color: '#3c4257' }
                },
                showInLegend: true
            }
        },
        legend: {
            itemStyle: { fontSize: '12px', fontWeight: '400', color: '#3c4257' }
        },
        colors: ['#3a5ba0', '#f7c873', '#2d1e2f', '#b0b8c1'],
        series: [{
            name: 'Learners',
            colorByPoint: true,
            data: [
                { name: 'Active (within 30 days)', y: {{pie_active}}, sliced: true, selected: true },
                { name: 'Inactive (beyond 30 days)', y: {{pie_inactive30}} },
                { name: 'Suspended', y: {{pie_suspended}} },
                { name: 'Created (never logged in)', y: {{pie_never}} }
            ]
        }],
        credits: { enabled: false }
    });

    // ===== HIGHCHARTS: Monthly Enrollment Column =====
    Highcharts.chart('enrollmentChart', {
        chart: {
            type: 'column',
            backgroundColor: 'transparent',
            style: { fontFamily: "'Libre Baskerville', Georgia, serif" }
        },
        title: { text: '' },
        xAxis: {
            categories: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
            crosshair: true,
            labels: { style: { color: '#6b7280', fontSize: '11px' } }
        },
        yAxis: {
            min: 0,
            title: { text: 'New Enrollments', style: { color: '#6b7280' } },
            gridLineColor: '#e5e7eb'
        },
        tooltip: {
            headerFormat: '<span style="font-size:13px;font-weight:600">{point.key}</span><br>',
            pointFormat: '<b>{point.y}</b> enrollments',
            backgroundColor: '#1a2238',
            borderColor: '#1a2238',
            style: { color: '#fff' }
        },
        plotOptions: {
            column: {
                borderWidth: 0,
                borderRadius: 5,
                dataLabels: {
                    enabled: true,
                    style: { fontSize: '11px', fontWeight: '600', color: '#3a5ba0' }
                },
                color: {
                    linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
                    stops: [[0, '#3a5ba0'], [1, '#6ea3c1']]
                }
            }
        },
        series: [{
            name: 'Enrollments',
            data: [
                {{enrol_month_1}}, {{enrol_month_2}}, {{enrol_month_3}},
                {{enrol_month_4}}, {{enrol_month_5}}, {{enrol_month_6}},
                {{enrol_month_7}}, {{enrol_month_8}}, {{enrol_month_9}},
                {{enrol_month_10}}, {{enrol_month_11}}, {{enrol_month_12}}
            ]
        }],
        legend: { enabled: false },
        credits: { enabled: false }
    });

    // ===== DATATABLES =====
    var dtDefaults = {
        dom: 'Blfrtip',
        lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'All']],
        buttons: [
            { extend: 'excel', className: 'admindash-dt-btn' },
            { extend: 'pdf', className: 'admindash-dt-btn' }
        ],
        language: { emptyTable: 'No data available' },
        pageLength: 10
    };

    // Tutor table with expandable detail rows.
    var tutorTable = $('#tutorTable').DataTable(Object.assign({}, dtDefaults, {
        order: [[3, 'desc']],
        columnDefs: [{ orderable: false, targets: 0 }]
    }));

    // HTML-escape utility to prevent XSS in child row content.
    function escHtml(str) {
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(str));
        return d.innerHTML;
    }

    // Build child row HTML from detail JSON.
    function formatTutorDetails(d) {
        var html = '<div class="tutor-detail-grid">';

        // Approved Programmes panel.
        html += '<div class="tutor-detail-card">';
        html += '<div class="tutor-detail-hdr"><i class="bi bi-journal-bookmark"></i> Approved Programmes</div>';
        html += '<div class="tutor-detail-body">';
        if (d.programmes && d.programmes.length > 0) {
            html += '<div class="tutor-detail-table-hdr"><span>Type</span><span>Caseload</span></div>';
            for (var i = 0; i < d.programmes.length; i++) {
                html += '<div class="programme-row">';
                html += '<span class="programme-title">' + escHtml(d.programmes[i].name) + '</span>';
                html += '<span class="caseload-badge">' + d.programmes[i].caseload + '</span>';
                html += '</div>';
            }
        } else {
            html += '<div class="tutor-detail-empty">No programmes assigned</div>';
        }
        html += '</div></div>';

        // Overdue / Stats panel.
        html += '<div class="tutor-detail-card">';
        html += '<div class="tutor-detail-hdr tutor-detail-hdr--alt"><i class="bi bi-exclamation-triangle"></i> Learners with Overdue Assignments</div>';
        html += '<div class="tutor-detail-body">';
        html += '<div class="stat-row"><span>Overdue Assignments</span><span class="badge-circle badge-circle--red">' + d.overdue + '</span></div>';
        html += '<div class="stat-row"><span>Imminent Assignments</span><span class="badge-circle badge-circle--amber">' + d.imminent + '</span></div>';
        html += '<div class="stat-row"><span>Awaiting Marking</span><span class="badge-circle badge-circle--blue">' + d.awaiting + '</span></div>';
        html += '<div class="stat-row"><span>InActive Learners</span><span class="badge-circle badge-circle--slate">' + d.inactive + '</span></div>';
        html += '</div></div>';

        html += '</div>';
        return html;
    }

    // Toggle child row on click.
    $('#tutorTable tbody').on('click', '.admindash-toggle-btn', function() {
        var tr = $(this).closest('tr');
        var row = tutorTable.row(tr);
        if (row.child.isShown()) {
            row.child.hide();
            tr.removeClass('shown');
            $(this).find('i').removeClass('bi-dash-circle').addClass('bi-plus-circle');
        } else {
            try {
                var details = JSON.parse(tr.attr('data-details'));
                row.child(formatTutorDetails(details)).show();
                tr.addClass('shown');
                $(this).find('i').removeClass('bi-plus-circle').addClass('bi-dash-circle');
            } catch(e) {
                console.error('Failed to parse tutor details', e);
            }
        }
    });

    $('#courseTable').DataTable(Object.assign({}, dtDefaults, { order: [[1, 'desc']] }));

    // Online users table (no export buttons, compact).
    if ($('#onlineTable').length) {
        $('#onlineTable').DataTable({
            dom: 'lfrtip',
            lengthMenu: [[10, 25, -1], [10, 25, 'All']],
            order: [[3, 'asc']],
            language: { emptyTable: 'No users currently online' },
            pageLength: 10
        });
    }
});
</script>

<style>
/* ==========================================================================
   ADMIN DASHBOARD — Editorial Aesthetic
   Font: Libre Baskerville | Palette: Deep Blue / Gold / Teal
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap');

/* --- Reset within dashboard scope --- */
#admin-dashboard *,
#admin-dashboard *::before,
#admin-dashboard *::after {
    box-sizing: border-box;
}

.admindash-shell {
    font-family: 'Libre Baskerville', Georgia, serif;
    color: #1a2238;
    max-width: 100%;
    padding: 0;
}

/* ==========================================================================
   HEADER
   ========================================================================== */
.admindash-header {
    background: linear-gradient(135deg, #1a2238 0%, #3a5ba0 60%, #6ea3c1 100%);
    border-radius: 10px;
    margin-bottom: 28px;
    position: relative;
    overflow: hidden;
}
.admindash-header::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -10%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(247,200,115,0.15) 0%, transparent 70%);
    border-radius: 50%;
}
.admindash-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 32px;
    position: relative;
    z-index: 1;
    flex-wrap: wrap;
    gap: 16px;
}
.admindash-title {
    font-size: 28px;
    font-weight: 700;
    color: #fff;
    margin: 0;
    letter-spacing: -0.5px;
}
.admindash-subtitle {
    font-size: 14px;
    color: rgba(255,255,255,0.65);
    margin: 4px 0 0;
    font-style: italic;
}
.admindash-header-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}
.admindash-hdr-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.12);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.2);
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-family: 'Libre Baskerville', Georgia, serif;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
}
.admindash-hdr-btn:hover {
    background: rgba(255,255,255,0.22);
    border-color: rgba(255,255,255,0.4);
    color: #fff;
    text-decoration: none;
}

/* ==========================================================================
   KPI CARDS — 4 across using CSS grid (no Bootstrap col clash with sidebar)
   ========================================================================== */
.admindash-kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 28px;
