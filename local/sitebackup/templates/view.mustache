{{!
    @template local_sitebackup/view

    Site Backup Manager dashboard.

    @package   local_sitebackup
    @copyright 2026 Epearl Academy
    @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

<div class="sb-shell">

  <!-- Header -->
  <div class="sb-header">
    <div class="sb-header-inner">
      <div>
        <h1 class="sb-header-title"><i class="bi bi-cloud-arrow-up"></i> {{#str}}pluginname, local_sitebackup{{/str}}</h1>
        <p class="sb-header-sub">Local download &amp; Google Drive backups &middot; Epearl Academy</p>
      </div>
      <div class="sb-header-actions">
        <button type="button" class="sb-hdr-btn sb-hdr-btn--success sb-backup-trigger"
                data-confirm="{{#str}}confirmbackuplocal, local_sitebackup{{/str}}"
                data-url="{{{backup_local_url}}}">
          <i class="bi bi-download"></i> {{#str}}localbackup, local_sitebackup{{/str}}
        </button>
        {{#drive_connected}}
        <button type="button" class="sb-hdr-btn sb-hdr-btn--drive sb-backup-trigger"
                data-confirm="{{#str}}confirmbackupdrive, local_sitebackup{{/str}}"
                data-url="{{{backup_drive_url}}}">
          <i class="bi bi-cloud-arrow-up"></i> {{#str}}drivebackup, local_sitebackup{{/str}}
        </button>
        {{/drive_connected}}
        <a href="{{{settings_url}}}" class="sb-hdr-btn"><i class="bi bi-gear"></i> {{#str}}settings, local_sitebackup{{/str}}</a>
        <a href="{{{diagnose_url}}}" class="sb-hdr-btn"><i class="bi bi-heart-pulse"></i> Diagnose</a>
      </div>
    </div>
  </div>

  <!-- Status Cards -->
  <div class="sb-cards">
    <div class="sb-card sb-card--backup">
      <div class="sb-card-top">
        <span class="sb-card-icon sb-card-icon--backup"><i class="bi bi-clock-history"></i></span>
        <span class="sb-card-label">{{#str}}lastbackup, local_sitebackup{{/str}}</span>
      </div>
      <div class="sb-card-value">{{last_backup_time}}</div>
      <div class="sb-card-detail">
        {{#last_backup_status}}
          <span class="sb-pill sb-pill--{{last_backup_pill}}">{{last_backup_status}}</span>
        {{/last_backup_status}}
        {{^last_backup_status}}
          {{#str}}never, local_sitebackup{{/str}}
        {{/last_backup_status}}
      </div>
    </div>

    <div class="sb-card sb-card--drive">
      <div class="sb-card-top">
        <span class="sb-card-icon sb-card-icon--drive"><i class="bi bi-google"></i></span>
        <span class="sb-card-label">{{#str}}googledrive, local_sitebackup{{/str}}</span>
      </div>
      <div class="sb-card-value">
        {{#drive_connected}}{{#str}}connected, local_sitebackup{{/str}}{{/drive_connected}}
        {{^drive_connected}}{{#str}}notconnected, local_sitebackup{{/str}}{{/drive_connected}}
      </div>
      <div class="sb-card-detail">
        {{#drive_connected}}
          <span class="sb-drive-dot sb-drive-dot--on"></span> Ready for uploads
        {{/drive_connected}}
        {{^drive_connected}}
          <span class="sb-drive-dot sb-drive-dot--off"></span> Configure below
        {{/drive_connected}}
      </div>
    </div>

    <div class="sb-card sb-card--schedule">
      <div class="sb-card-top">
        <span class="sb-card-icon sb-card-icon--schedule"><i class="bi bi-calendar3"></i></span>
        <span class="sb-card-label">{{#str}}nextscheduled, local_sitebackup{{/str}}</span>
      </div>
      <div class="sb-card-value">{{next_scheduled}}</div>
      <div class="sb-card-detail">Daily at 2:00 AM</div>
    </div>
  </div>

  <!-- Google Drive Connection -->
  <div class="sb-drive-section">
    <div class="sb-drive-status">
      {{#drive_connected}}
        <span class="sb-drive-dot sb-drive-dot--on"></span>
        <span>Google Drive is connected and ready for backups.</span>
      {{/drive_connected}}
      {{^drive_connected}}
        {{#drive_configured}}
          <span class="sb-drive-dot sb-drive-dot--off"></span>
          <span>Google Drive is not connected. Click to authorize.</span>
        {{/drive_configured}}
        {{^drive_configured}}
          <i class="bi bi-exclamation-triangle" style="color:#92400e;"></i>
          <span>{{#str}}configuredrive, local_sitebackup{{/str}}</span>
        {{/drive_configured}}
      {{/drive_connected}}
    </div>
    <div>
      {{#drive_connected}}
        <a href="{{{disconnect_url}}}" class="sb-drive-btn sb-drive-btn--disconnect"
           onclick="return confirm('{{#str}}confirmdisconnect, local_sitebackup{{/str}}');">
          <i class="bi bi-link-45deg"></i> {{#str}}disconnectdrive, local_sitebackup{{/str}}
        </a>
      {{/drive_connected}}
      {{^drive_connected}}
        {{#drive_configured}}
          <a href="{{{connect_url}}}" class="sb-drive-btn sb-drive-btn--connect">
            <i class="bi bi-link-45deg"></i> {{#str}}connectdrive, local_sitebackup{{/str}}
          </a>
        {{/drive_configured}}
      {{/drive_connected}}
    </div>
  </div>

  <!-- Backup History Table -->
  <div class="sb-panel">
    <div class="sb-panel-hdr">
      <h3><i class="bi bi-clock-history"></i> {{#str}}backuphistory, local_sitebackup{{/str}}</h3>
      <p>All backup runs with timestamps, status, and Google Drive links</p>
    </div>
    <div class="sb-panel-body">
      {{#has_logs}}
      <table class="sb-table">
        <thead>
          <tr>
            <th>{{#str}}date, local_sitebackup{{/str}}</th>
            <th>{{#str}}filename, local_sitebackup{{/str}}</th>
            <th>{{#str}}filesize, local_sitebackup{{/str}}</th>
            <th>{{#str}}contents, local_sitebackup{{/str}}</th>
            <th>{{#str}}status, local_sitebackup{{/str}}</th>
            <th>{{#str}}duration, local_sitebackup{{/str}}</th>
            <th>{{#str}}actions, local_sitebackup{{/str}}</th>
          </tr>
        </thead>
        <tbody>
          {{#logs}}
          <tr>
            <td>{{time}}</td>
            <td style="font-family:monospace;font-size:12px;">{{filename}}</td>
            <td>{{size_display}}</td>
            <td style="font-size:12px;">{{contents_display}}</td>
            <td>
              <span class="sb-pill sb-pill--{{status_class}}">{{status_display}}</span>
              {{#error_message}}
                <br><small style="color:#991b1b;" title="{{error_message}}">{{error_short}}</small>
              {{/error_message}}
            </td>
            <td>{{duration_display}}</td>
            <td>
              {{#has_local_file}}
                <a href="{{{download_url}}}" class="sb-action-btn sb-action-btn--download" title="{{#str}}download, local_sitebackup{{/str}}">
                  <i class="bi bi-download"></i>
                </a>
              {{/has_local_file}}
              {{#drive_link}}
                <a href="{{{drive_link}}}" target="_blank" class="sb-action-btn sb-action-btn--drive" title="{{#str}}openindrive, local_sitebackup{{/str}}">
                  <i class="bi bi-box-arrow-up-right"></i>
                </a>
              {{/drive_link}}
              {{#can_delete}}
                <a href="{{{delete_url}}}" class="sb-action-btn sb-action-btn--delete"
                   title="{{#str}}deletebackup, local_sitebackup{{/str}}"
                   onclick="return confirm('{{#str}}confirmdelete, local_sitebackup{{/str}}');">
                  <i class="bi bi-trash"></i>
                </a>
              {{/can_delete}}
            </td>
          </tr>
          {{/logs}}
        </tbody>
      </table>
      {{/has_logs}}
      {{^has_logs}}
      <div class="sb-empty">
        <i class="bi bi-cloud-arrow-up"></i>
        <p>{{#str}}nobackupsyet, local_sitebackup{{/str}}</p>
      </div>
      {{/has_logs}}
    </div>
  </div>

</div>

<!-- Progress overlay -->
<div id="sb-progress-overlay" class="sb-progress-overlay">
  <div class="sb-progress-box">
    <div class="spinner-border" role="status"></div>
    <p>Running backup... please wait</p>
  </div>
</div>
