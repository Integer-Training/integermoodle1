{{!
    SMS Log viewer template for local_twiliosms.

    @package   local_twiliosms
    @copyright 2025 Epearl Academy
    @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .twiliosms-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px 0;
        font-family: 'Libre Baskerville', serif;
    }
    .twiliosms-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        padding: 16px 20px;
        background: linear-gradient(90deg, #3a5ba0, #6ea3c1);
        border-radius: 8px;
        color: #fff;
    }
    .twiliosms-header h2 {
        margin: 0;
        font-size: 1.4rem;
        font-weight: 700;
        color: #fff;
    }
    .twiliosms-header a {
        color: #f7c873;
        text-decoration: none;
        font-size: 0.85rem;
    }
    .twiliosms-header a:hover {
        text-decoration: underline;
    }
    .twiliosms-table-wrap {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 16px;
        overflow-x: auto;
    }
    #smslog-table thead th {
        background: #3a5ba0;
        color: #fff;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: none;
        padding: 10px 12px;
    }
    #smslog-table tbody td {
        font-size: 0.82rem;
        vertical-align: middle;
        padding: 8px 12px;
        color: #1a2238;
    }
    #smslog-table tbody tr:nth-child(even) {
        background: #f5f7fa;
    }
    .badge-sent {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        background: #22c55e;
        color: #fff;
    }
    .badge-failed {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        background: #ef4444;
        color: #fff;
    }
    .badge-skipped {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        background: #b0b8c1;
        color: #fff;
    }
    .twiliosms-empty {
        text-align: center;
        padding: 60px 20px;
        color: #b0b8c1;
        font-size: 1rem;
    }
    .twiliosms-empty i {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 12px;
    }
    .dt-buttons .btn {
        background: #3a5ba0 !important;
        border: none !important;
        color: #fff !important;
        font-size: 0.78rem !important;
        border-radius: 6px !important;
        padding: 5px 14px !important;
        margin-right: 4px !important;
    }
    .dt-buttons .btn:hover {
        background: #2d4a82 !important;
    }
    .dataTables_filter input {
        border-radius: 6px !important;
        border: 1px solid #b0b8c1 !important;
        padding: 5px 10px !important;
    }
    .btn-retry {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        background: #f7c873;
        color: #1a2238;
        text-decoration: none;
        transition: background 0.2s;
    }
    .btn-retry:hover {
        background: #e5b45e;
        color: #1a2238;
        text-decoration: none;
    }
</style>

<div class="twiliosms-wrap">
    <div class="twiliosms-header">
        <h2><i class="bi bi-chat-dots-fill"></i> SMS Logs</h2>
        <a href="{{settings_url}}"><i class="bi bi-gear"></i> Settings</a>
    </div>

    {{#haslogs}}
    <div class="twiliosms-table-wrap">
        <table id="smslog-table" class="table table-sm" style="width:100%">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Phone</th>
                    <th>Message</th>
                    <th>Status</th>
                    <th>Error</th>
                    <th>Time</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {{#logs}}
                <tr>
                    <td>{{fullname}}<br><small style="color:#6ea3c1">{{username}}</small></td>
                    <td>{{phone}}</td>
                    <td style="max-width:220px;word-break:break-word;">{{message}}</td>
                    <td>
                        {{#is_sent}}<span class="badge-sent">Sent</span>{{/is_sent}}
                        {{#is_failed}}<span class="badge-failed">Failed</span>{{/is_failed}}
                        {{#is_skipped}}<span class="badge-skipped">Skipped</span>{{/is_skipped}}
                    </td>
                    <td style="max-width:180px;word-break:break-word;"><small>{{error_msg}}</small></td>
                    <td>{{timecreated}}</td>
                    <td>
                        {{#can_retry}}
                        <a href="{{retry_url}}" class="btn-retry" title="Retry sending SMS">
                            <i class="bi bi-arrow-clockwise"></i> Retry
                        </a>
                        {{/can_retry}}
                        {{#is_sent}}
                        <span style="color:#22c55e;font-size:0.78rem;"><i class="bi bi-check-circle-fill"></i></span>
                        {{/is_sent}}
                    </td>
                </tr>
                {{/logs}}
            </tbody>
        </table>
    </div>
    {{/haslogs}}

    {{^haslogs}}
    <div class="twiliosms-empty">
        <i class="bi bi-inbox"></i>
        No SMS logs found.
    </div>
    {{/haslogs}}
</div>

<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof jQuery !== 'undefined' && jQuery.fn.DataTable) {
            jQuery('#smslog-table').DataTable({
                order: [[5, 'desc']],
                columnDefs: [{orderable: false, targets: 6}],
                pageLength: 25,
                dom: 'Bfrtip',
                buttons: [
                    {extend: 'csvHtml5', title: 'SMS_Logs', className: 'btn btn-sm'},
                    {extend: 'excelHtml5', title: 'SMS_Logs', className: 'btn btn-sm'}
                ]
            });
        }
    });
</script>
