{{!
    @template local_learnerprogression/progressions

    Learner Progressions — shows current progression per learner
    with expandable unit-wise (per-course + per-assignment) breakdown.

    @package   local_learnerprogression
    @copyright 2026 Integer Training
    @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}

<div class="prog-shell" id="learner-progressions">

  <!-- ===== HEADER BAR ===== -->
  <div class="prog-header">
    <div class="prog-header-inner">
      <div>
        <h1 class="prog-title">Learner Progressions</h1>
        <p class="prog-subtitle">Progression tracking with unit-wise breakdown &middot; Integer Training</p>
      </div>
      {{#is_manager}}
      <div class="prog-header-actions">
        <a href="{{{wwwroot}}}/local/learner/view.php" class="prog-hdr-btn">
          <i class="bi bi-people"></i> Learners
        </a>
        <a href="{{{wwwroot}}}/local/learner/admindash.php" class="prog-hdr-btn">
          <i class="bi bi-speedometer2"></i> Dashboard
        </a>
      </div>
      {{/is_manager}}
    </div>
  </div>

  <!-- ===== KPI CARDS ===== -->
  <div class="prog-kpis">

    <div class="prog-kpi-card">
      <div class="prog-kpi-top">
        <span class="prog-kpi-icon prog-kpi-icon--learners">
          <i class="bi bi-people-fill"></i>
        </span>
        <span class="prog-kpi-label">Total Learners (Excl. Suspended)</span>
      </div>
      <div class="prog-kpi-value">{{{total_learners_count}}}</div>
    </div>

    <div class="prog-kpi-card prog-kpi-card--green">
      <div class="prog-kpi-top">
        <span class="prog-kpi-icon prog-kpi-icon--active">
          <i class="bi bi-check-circle-fill"></i>
        </span>
        <span class="prog-kpi-label">Active</span>
      </div>
      <div class="prog-kpi-value">{{{active_count}}}</div>
    </div>

    <div class="prog-kpi-card prog-kpi-card--amber">
      <div class="prog-kpi-top">
        <span class="prog-kpi-icon prog-kpi-icon--inactive">
          <i class="bi bi-clock-history"></i>
        </span>
        <span class="prog-kpi-label">Inactive (30+ Days)</span>
      </div>
      <div class="prog-kpi-value">{{{inactive_count}}}</div>
    </div>

    <div class="prog-kpi-card prog-kpi-card--blue">
      <div class="prog-kpi-top">
        <span class="prog-kpi-icon prog-kpi-icon--created">
          <i class="bi bi-person-plus-fill"></i>
        </span>
        <span class="prog-kpi-label">Created (Never Logged In)</span>
      </div>
      <div class="prog-kpi-value">{{{created_count}}}</div>
    </div>

    <div class="prog-kpi-card prog-kpi-card--grey">
      <div class="prog-kpi-top">
        <span class="prog-kpi-icon prog-kpi-icon--suspended">
          <i class="bi bi-person-slash"></i>
        </span>
        <span class="prog-kpi-label">Suspended</span>
      </div>
      <div class="prog-kpi-value">{{{suspended_count}}}</div>
    </div>

  </div>

  <!-- ===== MAIN TABLE ===== -->
  <div class="prog-panel">
    <div class="prog-panel-hdr">
      <div>
        <h3><i class="bi bi-bar-chart-steps"></i> Learner Progression Details</h3>
        <p>Click the + icon to expand unit-wise breakdown per learner</p>
      </div>
    </div>
    <div class="prog-panel-body">
      <!-- Filter Bar -->
      <div class="prog-filter-bar">
        <div class="prog-filter-group">
          <label class="prog-filter-label" for="progFilterActivity">Activity Status</label>
          <select id="progFilterActivity" class="prog-filter-select">
            <option value="">All</option>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
            <option value="Created">Created</option>
          </select>
        </div>
        <div class="prog-filter-group">
          <label class="prog-filter-label" for="progFilterProgress">Progression</label>
          <select id="progFilterProgress" class="prog-filter-select">
            <option value="">All</option>
            <option value="0-25">0 – 25%</option>
            <option value="26-50">26 – 50%</option>
            <option value="51-75">51 – 75%</option>
            <option value="76-100">76 – 100%</option>
          </select>
        </div>
        <div class="prog-filter-group">
          <label class="prog-filter-label" for="progFilterCourse">Course</label>
          <select id="progFilterCourse" class="prog-filter-select">
            <option value="">All Courses</option>
            {{#course_list}}
            <option value="{{name}}">{{name}}</option>
            {{/course_list}}
          </select>
        </div>
        {{#is_manager}}
        <div class="prog-filter-group">
          <label class="prog-filter-label" for="progFilterTutor">Tutor</label>
          <select id="progFilterTutor" class="prog-filter-select">
            <option value="">All Tutors</option>
            {{#tutor_list}}
            <option value="{{name}}">{{name}}</option>
            {{/tutor_list}}
            <option value="Unassigned">Unassigned</option>
          </select>
        </div>
        {{/is_manager}}
        <button id="progFilterReset" class="prog-filter-reset"><i class="bi bi-arrow-counterclockwise"></i> Reset Filters</button>
      </div>

      <table id="progTable" class="prog-table display" style="width:100%">
        <thead>
          <tr>
            <th style="width:36px"></th>
            <th>Learner Name</th>
            {{#is_manager}}<th>Tutor</th>{{/is_manager}}
            <th>Start Date</th>
            <th>Activity</th>
            <th>Current %</th>
            <th style="text-align:center">Submitted / Total</th>
            <th style="text-align:center">Passed / Total</th>
          </tr>
        </thead>
        <tbody>
          {{#learners}}
          <tr class="prog-learner-row" data-details="{{detail_json}}" data-courses="{{course_names}}">
            <td class="prog-toggle-cell"><span class="prog-toggle-btn"><i class="bi bi-plus-circle"></i></span></td>
            <td class="prog-cell-name">{{{fullname}}}</td>
            {{#is_manager}}<td class="prog-cell-tutor">{{{tutor_name}}}</td>{{/is_manager}}
            <td class="prog-cell-date">{{{start_date}}}</td>
            <td class="prog-cell-activity">{{{activity_status}}}</td>
            <td>
              <div class="prog-bar-wrap">
                <div class="prog-bar prog-bar--default" style="width:{{overall_current}}%"></div>
              </div>
              <span class="prog-bar-label">{{overall_current}}%</span>
            </td>
            <td class="text-center">
              <span class="prog-pill prog-pill--submitted">{{{submitted_assignments}}} / {{{total_assignments}}}</span>
            </td>
            <td class="text-center">
              <span class="prog-pill">{{{passed_assignments}}} / {{{total_assignments}}}</span>
            </td>
          </tr>
          {{/learners}}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Case Study Reject Modal -->
  <div id="progRejectModal" class="prog-modal-overlay" style="display:none">
    <div class="prog-modal">
      <div class="prog-modal-header" style="background: linear-gradient(135deg, #dc2626, #b91c1c);">
        <h4><i class="bi bi-x-circle"></i> Reject Case Study</h4>
      </div>
      <div class="prog-modal-body" style="padding:24px">
        <p style="font-size:14px;color:#374151;margin:0 0 12px">Provide feedback for the learner (optional):</p>
        <textarea id="progRejectFeedback" rows="4" style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:10px;font-size:13px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;resize:vertical" placeholder="Reason for rejection..."></textarea>
        <input type="hidden" id="progRejectAssignId" value="">
        <input type="hidden" id="progRejectUserId" value="">
      </div>
      <div class="prog-modal-footer" style="display:flex;gap:8px;justify-content:flex-end">
        <button id="progRejectCancel" class="prog-modal-close-btn" style="background:#6b7280">Cancel</button>
        <button id="progRejectConfirm" class="prog-modal-close-btn" style="background:#dc2626">Reject</button>
      </div>
    </div>
  </div>

  <!-- Learning Times Modal -->
  <div id="progTimesModal" class="prog-modal-overlay" style="display:none">
    <div class="prog-modal">
      <div class="prog-modal-header">
        <h4><i class="bi bi-clock-history"></i> Learning Times</h4>
      </div>
      <div class="prog-modal-body">
        <table class="prog-times-table">
          <thead>
            <tr>
              <th>Date Accessed</th>
              <th>Start</th>
              <th>End</th>
              <th>Length of Access</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="prog-modal-footer">
        <button id="progTimesModalClose" class="prog-modal-close-btn">Close</button>
      </div>
    </div>
  </div>

</div>

<!-- ===== CDN: DataTables Buttons ===== -->
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css">
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/1.6.2/css/buttons.dataTables.min.css">
<script src="https://cdn.datatables.net/buttons/1.6.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/1.6.2/js/buttons.flash.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
<script src="https://cdn.datatables.net/buttons/1.6.2/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/1.6.2/js/buttons.print.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {

    // ===== COLUMN INDEX DETECTION =====
    // Admin view has Tutor column; tutor view does not.
    var hasTutorCol = $('#progTable thead th').length > 7;
    var COL_TUTOR    = hasTutorCol ? 2 : -1;
    var COL_DATE     = hasTutorCol ? 3 : 2;
    var COL_ACTIVITY = hasTutorCol ? 4 : 3;
    var COL_CURRENT  = hasTutorCol ? 5 : 4;

    // ===== DATATABLES =====
    var progTable = $('#progTable').DataTable({
        dom: 'Blfrtip',
        lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'All']],
        buttons: [
            { extend: 'excel', className: 'prog-dt-btn', title: 'Learner_Progressions' },
            { extend: 'pdf', className: 'prog-dt-btn', title: 'Learner_Progressions' }
        ],
        language: { emptyTable: 'No learners found' },
        pageLength: 25,
        order: [[COL_CURRENT, 'desc']],
        columnDefs: [{ orderable: false, targets: 0 }],
        // Render Activity column as badge
        createdRow: function(row, data, dataIndex) {
            var $actCell = $('td.prog-cell-activity', row);
            var val = $.trim($actCell.text());
            if (val === 'Active') {
                $actCell.html('<span class="prog-activity-badge prog-activity--active">Active</span>');
            } else if (val === 'Inactive') {
                $actCell.html('<span class="prog-activity-badge prog-activity--inactive">Inactive</span>');
            } else if (val === 'Created') {
                $actCell.html('<span class="prog-activity-badge prog-activity--created">Created</span>');
            }
        }
    });

    // ===== CUSTOM FILTERS =====

    // Activity status filter.
    $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
        if (settings.nTable.id !== 'progTable') return true;
        var filterVal = $('#progFilterActivity').val();
        if (!filterVal) return true;
        return $.trim(data[COL_ACTIVITY]) === filterVal;
    });

    // Progression range filter (Current %).
    $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
        if (settings.nTable.id !== 'progTable') return true;
        var filterVal = $('#progFilterProgress').val();
        if (!filterVal) return true;
        var pct = parseInt(data[COL_CURRENT], 10) || 0;
        var parts = filterVal.split('-');
        var lo = parseInt(parts[0], 10);
        var hi = parseInt(parts[1], 10);
        return pct >= lo && pct <= hi;
    });

    // Tutor filter (admin only).
    $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
        if (settings.nTable.id !== 'progTable') return true;
        if (COL_TUTOR < 0) return true; // No tutor column (tutor view).
        var filterVal = $('#progFilterTutor').val();
        if (!filterVal) return true;
        return $.trim(data[COL_TUTOR]) === filterVal;
    });

    // Course filter (checks data-courses attribute on each row).
    $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
        if (settings.nTable.id !== 'progTable') return true;
        var filterVal = $('#progFilterCourse').val();
        if (!filterVal) return true;
        var row = progTable.row(dataIndex).node();
        var courses = $(row).attr('data-courses') || '';
        var courseArr = courses.split('||');
        return courseArr.indexOf(filterVal) !== -1;
    });

    // Wire up filter controls.
    $('#progFilterActivity, #progFilterProgress, #progFilterTutor, #progFilterCourse').on('change', function() {
        progTable.draw();
    });
    $('#progFilterReset').on('click', function() {
        $('#progFilterActivity').val('');
        $('#progFilterProgress').val('');
        $('#progFilterTutor').val('');
        $('#progFilterCourse').val('');
        progTable.draw();
    });

    // HTML-escape utility.
    function escHtml(str) {
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(str));
        return d.innerHTML;
    }

    // Build expandable child row: courses with assignments listed under each.
    function formatProgDetails(courses) {
        var html = '<div class="prog-detail-wrap">';

        for (var i = 0; i < courses.length; i++) {
            var c = courses[i];
            var cPct = c.current;

            // Course header row.
            html += '<div class="prog-course-block">';
            html += '<div class="prog-course-header">';
            html += '<div class="prog-course-name"><i class="bi bi-journal-bookmark"></i> ' + escHtml(c.name) + '</div>';
            html += '<div class="prog-course-stats">';
            html += '<span class="prog-pill" style="margin-left:8px;background:rgba(255,255,255,0.2);color:#fff">Submitted: ' + c.submitted + ' / ' + c.total + '</span>';
            html += '<span class="prog-pill" style="margin-left:8px;background:rgba(255,255,255,0.2);color:#fff">Passed: ' + c.passed + ' / ' + c.total + '</span>';
            // Learning hours badge.
            if (!window.__progSessions) window.__progSessions = [];
            var sessIdx = window.__progSessions.length;
            window.__progSessions.push(c.sessions || []);
            html += '<span class="prog-hours-badge" data-sess-idx="' + sessIdx + '" style="margin-left:8px" title="Click to view session log"><i class="bi bi-clock-history"></i> ' + escHtml(c.hours || '0m') + '</span>';
            html += '<div class="prog-bar-wrap" style="width:100px;margin-left:8px"><div class="prog-bar prog-bar--default" style="width:' + cPct + '%"></div></div>';
            html += '<span class="prog-bar-label">' + cPct + '%</span>';
            html += '</div></div>';

            // Assignment rows under this course.
            html += '<table class="prog-unit-table">';
            html += '<thead><tr><th style="text-align:center">Assignment / Unit</th><th style="text-align:center">Status</th><th style="text-align:center">Actions</th></tr></thead>';
            html += '<tbody>';
            if (c.assignments && c.assignments.length > 0) {
                for (var j = 0; j < c.assignments.length; j++) {
                    var a = c.assignments[j];
                    var statusClass = 'prog-unit-status--notsubmitted';
                    var displayStatus = a.status;
                    if (a.status === 'Pass') statusClass = 'prog-unit-status--pass';
                    else if (a.status === 'Refer') { statusClass = 'prog-unit-status--refer'; displayStatus = 'Needs Revision'; }
                    else if (a.status === 'Pending Grading') statusClass = 'prog-unit-status--pending';
                    else if (a.status === 'Submitted') statusClass = 'prog-unit-status--submitted';
                    else if (a.status === 'Approved') statusClass = 'prog-unit-status--approved';
                    else if (a.status === 'Rejected') statusClass = 'prog-unit-status--rejected';
                    else if (a.status === 'Resubmitted') statusClass = 'prog-unit-status--resubmitted';

                    html += '<tr>';
                    html += '<td class="prog-unit-name" style="text-align:center">' + escHtml(a.name) + '</td>';
                    html += '<td style="text-align:center"><span class="prog-unit-status ' + statusClass + '">' + escHtml(a.status) + '</span>';
                    // Show feedback tooltip for rejected case studies.
                    if (a.feedback && (a.status === 'Rejected' || a.status === 'Resubmitted')) {
                        html += ' <span class="prog-cs-feedback-icon" title="' + escHtml(a.feedback) + '"><i class="bi bi-chat-square-text"></i></span>';
                    }
                    html += '</td>';

                    // Actions column: Approve/Reject for case studies with Submitted or Resubmitted status.
                    html += '<td style="text-align:center">';
                    if (a.is_case_study && (a.status === 'Submitted' || a.status === 'Resubmitted')) {
                        html += '<button class="prog-cs-btn prog-cs-btn--approve" data-action="approve" data-assignid="' + a.assignid + '" data-userid="' + a.userid + '"><i class="bi bi-check-lg"></i> Approve</button> ';
                        html += '<button class="prog-cs-btn prog-cs-btn--reject" data-action="reject" data-assignid="' + a.assignid + '" data-userid="' + a.userid + '"><i class="bi bi-x-lg"></i> Reject</button>';
                    } else {
                        html += '<span style="color:#9ca3af;font-size:11px">—</span>';
                    }
                    html += '</td>';
                    html += '</tr>';
                }
            } else {
                html += '<tr><td colspan="3" class="prog-unit-empty">No assignments</td></tr>';
            }
            html += '</tbody></table>';
            html += '</div>';
        }

        if (courses.length === 0) {
            html += '<div class="prog-unit-empty" style="padding:20px;text-align:center">No course data available</div>';
        }

        html += '</div>';
        return html;
    }

    // Toggle child row on click.
    $('#progTable tbody').on('click', '.prog-toggle-btn', function() {
        var tr = $(this).closest('tr');
        var row = progTable.row(tr);
        if (row.child.isShown()) {
            row.child.hide();
            tr.removeClass('shown');
            $(this).find('i').removeClass('bi-dash-circle').addClass('bi-plus-circle');
        } else {
            try {
                var details = JSON.parse(tr.attr('data-details'));
                row.child(formatProgDetails(details)).show();
                tr.addClass('shown');
                $(this).find('i').removeClass('bi-plus-circle').addClass('bi-dash-circle');
            } catch(e) {
                console.error('Failed to parse progression details', e);
            }
        }
    });

    // Learning hours modal handlers.
    $(document).on('click', '.prog-hours-badge', function(e) {
        e.stopPropagation();
        var idx = $(this).data('sess-idx');
        var sessions = (window.__progSessions && window.__progSessions[idx]) ? window.__progSessions[idx] : [];
        var $modal = $('#progTimesModal');
        var $tbody = $modal.find('.prog-times-table tbody');
        $tbody.empty();
        if (sessions.length === 0) {
            $tbody.append('<tr><td colspan="4" style="text-align:center;color:#9ca3af;font-style:italic;padding:20px">No session data available</td></tr>');
        } else {
            for (var s = 0; s < sessions.length; s++) {
                var sess = sessions[s];
                $tbody.append('<tr><td>' + escHtml(sess.date) + '</td><td>' + escHtml(sess.start) + '</td><td>' + escHtml(sess.end) + '</td><td>' + escHtml(sess.length) + '</td></tr>');
            }
        }
        $modal.fadeIn(200);
    });

    // Close modal.
    $(document).on('click', '#progTimesModalClose', function() {
        $('#progTimesModal').fadeOut(200);
    });
    $(document).on('click', '.prog-modal-overlay', function(e) {
        if ($(e.target).hasClass('prog-modal-overlay')) {
            $(e.target).fadeOut(200);
        }
    });

    // ===== CASE STUDY APPROVE/REJECT HANDLERS =====
    try {
    var csReviewUrl = (typeof M !== 'undefined' && M.cfg) ? M.cfg.wwwroot + '/local/learner/casestudy_review.php' : '';
    var csSesskey = '{{sesskey}}';

    // Approve button click.
    $(document).on('click', '.prog-cs-btn--approve', function(e) {
        e.stopPropagation();
        var $btn = $(this);
        var assignid = $btn.data('assignid');
        var userid = $btn.data('userid');
        $btn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> ...');
        $.post(csReviewUrl, {
            action: 'approve', assignid: assignid, userid: userid, sesskey: csSesskey
        }).done(function(resp) {
            if (resp.success) {
                var $row = $btn.closest('tr');
                $row.find('.prog-unit-status').removeClass('prog-unit-status--submitted prog-unit-status--resubmitted')
                    .addClass('prog-unit-status--approved').text('Approved');
                $row.find('.prog-cs-feedback-icon').remove();
                $btn.closest('td').html('<span style="color:#9ca3af;font-size:11px">—</span>');
            }
        }).fail(function() {
            alert('Failed to approve case study.');
            $btn.prop('disabled', false).html('<i class="bi bi-check-lg"></i> Approve');
        });
    });

    // Reject button click — open modal.
    $(document).on('click', '.prog-cs-btn--reject', function(e) {
        e.stopPropagation();
        $('#progRejectAssignId').val($(this).data('assignid'));
        $('#progRejectUserId').val($(this).data('userid'));
        $('#progRejectFeedback').val('');
        $('#progRejectModal').fadeIn(200);
    });

    // Reject modal cancel.
    $(document).on('click', '#progRejectCancel', function() {
        $('#progRejectModal').fadeOut(200);
    });

    // Reject modal confirm.
    $(document).on('click', '#progRejectConfirm', function() {
        var assignid = $('#progRejectAssignId').val();
        var userid = $('#progRejectUserId').val();
        var feedback = $('#progRejectFeedback').val();
        var $btn = $(this);
        $btn.prop('disabled', true).text('Rejecting...');
        $.post(csReviewUrl, {
            action: 'reject', assignid: assignid, userid: userid,
            feedback: feedback, sesskey: csSesskey
        }).done(function(resp) {
            if (resp.success) {
                // Update the status in the currently open child row.
                var $actBtn = $('.prog-cs-btn--reject[data-assignid="' + assignid + '"][data-userid="' + userid + '"]');
                var $row = $actBtn.closest('tr');
                $row.find('.prog-unit-status').removeClass('prog-unit-status--submitted prog-unit-status--resubmitted')
                    .addClass('prog-unit-status--rejected').text('Rejected');
                // Add feedback icon if feedback provided.
                if (feedback) {
                    $row.find('.prog-unit-status').after(' <span class="prog-cs-feedback-icon" title="' + escHtml(feedback) + '"><i class="bi bi-chat-square-text"></i></span>');
                }
                $actBtn.closest('td').html('<span style="color:#9ca3af;font-size:11px">—</span>');
                $('#progRejectModal').fadeOut(200);
            }
        }).fail(function() {
            alert('Failed to reject case study.');
        }).always(function() {
            $btn.prop('disabled', false).text('Reject');
        });
    });
    } catch(e) { /* jQuery not available — case study handlers not registered */ }

});
</script>

<style>
/* ==========================================================================
   LEARNER PROGRESSIONS — Editorial Aesthetic (prog- namespace)
   Font: Libre Baskerville | Palette: Deep Blue / Gold / Teal
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap');

#learner-progressions *,
#learner-progressions *::before,
#learner-progressions *::after {
    box-sizing: border-box;
}

.prog-shell {
