{{!
    @template local_learnerdashboard/dashboard

    Learner Dashboard — personalised overview with progression,
    messages, due dates, KPI cards and hours chart.

    @package   local_learnerdashboard
    @copyright 2026 Epearl Academy
    @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}

<div class="ld-shell" id="learner-dashboard">

  <!-- ===== HEADER ===== -->
  <div class="ld-header">
    <div class="ld-header-left">
      <span class="ld-avatar" data-name="{{{name}}}"></span>
      <div>
        <h1 class="ld-title">Welcome back, {{{name}}}</h1>
        <p class="ld-subtitle">Here's your learning overview</p>
      </div>
    </div>
    <div class="ld-header-actions">
      <a href="{{{mycourses_link}}}" class="ld-btn"><i class="bi bi-journal-bookmark"></i> My Courses</a>
      <a href="{{{mail_link}}}" class="ld-btn"><i class="bi bi-envelope"></i> Inbox</a>
      <a href="{{{contact_link}}}" class="ld-btn ld-btn--ghost"><i class="bi bi-headset"></i> Support</a>
    </div>
  </div>

  <!-- Decorative mesh blobs -->
  <div class="ld-blob ld-blob--1"></div>
  <div class="ld-blob ld-blob--2"></div>

  <!-- ===== KPI CARDS ===== -->
  <div class="ld-kpis">
    <a href="{{{mycourses_link}}}" class="ld-kpi ld-kpi--blue">
      <div class="ld-kpi-icon"><i class="bi bi-book"></i></div>
      <div class="ld-kpi-body">
        <span class="ld-kpi-val">{{{enrolled_courses}}}</span>
        <span class="ld-kpi-label">Enrolled Courses</span>
      </div>
    </a>
    <div class="ld-kpi ld-kpi--amber">
      <div class="ld-kpi-icon"><i class="bi bi-hourglass-split"></i></div>
      <div class="ld-kpi-body">
        <span class="ld-kpi-val">{{{due_assignments}}}</span>
        <span class="ld-kpi-label">Due Assignments</span>
      </div>
    </div>
    <div class="ld-kpi ld-kpi--green">
      <div class="ld-kpi-icon"><i class="bi bi-check-circle"></i></div>
      <div class="ld-kpi-body">
        <span class="ld-kpi-val">{{{completed_assignments}}}</span>
        <span class="ld-kpi-label">Completed</span>
      </div>
    </div>
    <div class="ld-kpi ld-kpi--cyan">
      <div class="ld-kpi-icon"><i class="bi bi-graph-up-arrow"></i></div>
      <div class="ld-kpi-body">
        <span class="ld-kpi-val">{{{overall_progress}}}<small>%</small></span>
        <span class="ld-kpi-label">Overall Progress</span>
      </div>
    </div>
    <a href="{{{mail_link}}}" class="ld-kpi ld-kpi--purple">
      <div class="ld-kpi-icon">
        <i class="bi bi-envelope-open"></i>
        {{#has_unread}}<span class="ld-kpi-badge">{{{unread_messages}}}</span>{{/has_unread}}
      </div>
      <div class="ld-kpi-body">
        <span class="ld-kpi-val">{{{unread_messages}}}</span>
        <span class="ld-kpi-label">Unread Messages</span>
      </div>
    </a>
  </div>

  <!-- ===== PROGRESS RING + QUICK STATS ===== -->
  <div class="ld-progress-strip">
    <div class="ld-ring-wrap">
      <svg class="ld-ring" viewBox="0 0 120 120">
        <circle cx="60" cy="60" r="52" fill="none" stroke="#e5e7eb" stroke-width="10"/>
        <circle cx="60" cy="60" r="52" fill="none" stroke="url(#ldGrad)" stroke-width="10"
                stroke-linecap="round" stroke-dasharray="326.73" stroke-dashoffset="326.73"
                class="ld-ring-fill" data-pct="{{{overall_progress}}}"/>
        <defs><linearGradient id="ldGrad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#3b82f6"/><stop offset="100%" stop-color="#06b6d4"/>
        </linearGradient></defs>
      </svg>
      <div class="ld-ring-text">
        <span class="ld-ring-pct">{{{overall_progress}}}%</span>
        <span class="ld-ring-lbl">Complete</span>
      </div>
    </div>
    <div class="ld-quick-stats">
      <div class="ld-qs"><span class="ld-qs-num" style="color:#3b82f6">{{{enrolled_courses}}}</span><span class="ld-qs-lbl">Courses</span></div>
      <div class="ld-qs-divider"></div>
      <div class="ld-qs"><span class="ld-qs-num" style="color:#16a34a">{{{completed_assignments}}}</span><span class="ld-qs-lbl">Passed</span></div>
      <div class="ld-qs-divider"></div>
      <div class="ld-qs"><span class="ld-qs-num" style="color:#ca8a04">{{{due_assignments}}}</span><span class="ld-qs-lbl">Remaining</span></div>
    </div>
  </div>

  <!-- ===== TUTOR + FEEDBACKS ROW ===== -->
  <div class="ld-grid-2">

    <!-- My Tutor -->
    <div class="ld-card ld-card--tutor">
      <div class="ld-card-hdr" style="background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%);">
        <h3><i class="bi bi-person-badge"></i> My Tutor</h3>
      </div>
      {{#has_tutor}}
      <div class="ld-card-body">
        <div class="ld-tutor">
          <div class="ld-tutor-avatar">
            <img src="{{{tutor_info.picture_url}}}" alt="{{{tutor_info.fullname}}}" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
            <span class="ld-tutor-initials">{{{tutor_info.firstname}}}</span>
          </div>
          <div class="ld-tutor-info">
            <div class="ld-tutor-name">{{{tutor_info.fullname}}}</div>
            <div class="ld-tutor-email">{{{tutor_info.email}}}</div>
          </div>
          <div class="ld-tutor-actions">
            <a href="{{{tutor_info.message_url}}}" class="ld-btn-contact">
              <i class="bi bi-envelope"></i> Contact Tutor
            </a>
          </div>
        </div>
      </div>
      {{/has_tutor}}
      {{^has_tutor}}
      <div class="ld-card-body">
        <div class="ld-empty"><i class="bi bi-person-x"></i><p>No tutor assigned yet</p></div>
      </div>
      {{/has_tutor}}
    </div>

    <!-- Draft Feedbacks -->
    <div class="ld-card ld-card--feedbacks">
      <div class="ld-card-hdr" style="background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);">
        <h3><i class="bi bi-chat-square-text"></i> Draft Feedbacks</h3>
        <span class="ld-card-badge">{{{feedback_count}}} total</span>
      </div>
      {{#has_feedbacks}}
      <div class="ld-card-body ld-card-body--flush">
        {{#draft_feedbacks}}
        <a href="{{{view_url}}}" class="ld-feedback-item">
          <div class="ld-feedback-left">
            <div class="ld-feedback-name">{{{assignmentname}}}</div>
            <div class="ld-feedback-meta">{{{coursename}}} &middot; {{{submitted_date}}}</div>
          </div>
          <div class="ld-feedback-right">
            <span class="ld-feedback-status {{{status_class}}}">{{{status}}}</span>
          </div>
        </a>
        {{/draft_feedbacks}}
      </div>
      {{/has_feedbacks}}
      {{^has_feedbacks}}
      <div class="ld-card-body">
        <div class="ld-empty"><i class="bi bi-chat-square"></i><p>No draft feedbacks yet</p></div>
      </div>
      {{/has_feedbacks}}
    </div>

  </div>

  <!-- ===== TWO-COLUMN: DUE DATES + MESSAGES ===== -->
  <div class="ld-grid-2">

    <!-- Due Dates -->
    <div class="ld-card">
      <div class="ld-card-hdr">
        <h3><i class="bi bi-alarm"></i> Upcoming Due Dates</h3>
        <span class="ld-card-badge">{{{upcoming_count}}} upcoming</span>
      </div>
      {{#has_upcoming_due}}
      <div class="ld-card-body ld-card-body--flush">
        {{#upcoming_due}}
        <a href="{{{assign_link}}}" class="ld-due {{#is_red}}ld-due--red{{/is_red}}{{#is_amber}}ld-due--amber{{/is_amber}}{{#is_green}}ld-due--green{{/is_green}}">
          <div class="ld-due-left">
            <div class="ld-due-name">{{{assignname}}}</div>
            <div class="ld-due-meta">{{{coursename}}} &middot; {{{duedate}}}</div>
          </div>
          <div class="ld-due-right">
            <span class="ld-due-days">{{{days_remaining}}}</span>
            <span class="ld-due-unit">days left</span>
          </div>
        </a>
        {{/upcoming_due}}
      </div>
      {{/has_upcoming_due}}
      {{^has_upcoming_due}}
      <div class="ld-card-body">
        <div class="ld-empty"><i class="bi bi-calendar-check"></i><p>All caught up! No assignments due this week.</p></div>
      </div>
      {{/has_upcoming_due}}
    </div>

    <!-- Messages -->
    <div class="ld-card">
      <div class="ld-card-hdr">
        <h3><i class="bi bi-chat-left-text"></i> Recent Messages</h3>
        {{#has_messages}}<a href="{{{mail_link}}}" class="ld-card-link">View All <i class="bi bi-arrow-right"></i></a>{{/has_messages}}
      </div>
      {{#has_messages}}
      <div class="ld-card-body ld-card-body--flush">
        {{#recent_messages}}
        <a href="{{{view_link}}}" class="ld-msg{{#is_unread}} ld-msg--unread{{/is_unread}}">
          <div class="ld-msg-avatar">{{{sender_name}}}</div>
          <div class="ld-msg-body">
            <div class="ld-msg-top">
              <span class="ld-msg-name">{{{sender_name}}}</span>
              <span class="ld-msg-time">{{{time_ago}}}</span>
            </div>
            <div class="ld-msg-subject">{{{subject}}}</div>
            <div class="ld-msg-course">{{{coursename}}}</div>
          </div>
          {{#is_unread}}<span class="ld-msg-dot"></span>{{/is_unread}}
        </a>
        {{/recent_messages}}
      </div>
      {{/has_messages}}
      {{^has_messages}}
      <div class="ld-card-body">
        <div class="ld-empty"><i class="bi bi-envelope-open"></i><p>No messages yet</p></div>
      </div>
      {{/has_messages}}
    </div>

  </div>

  <!-- ===== MY PROGRESSION ===== -->
  <div class="ld-card">
    <div class="ld-card-hdr">
      <h3><i class="bi bi-bar-chart-steps"></i> Course Progression</h3>
      <a href="{{{progression_link}}}" class="ld-card-link">Full Report <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="ld-card-body">
      {{#has_progression}}
      <div class="ld-courses">
        {{#progression_courses}}
        <div class="ld-course" data-assignments='{{assignments_json}}'>
          <div class="ld-course-row">
            <button class="ld-course-toggle" aria-label="Expand"><i class="bi bi-chevron-right"></i></button>
            <div class="ld-course-info">
              <div class="ld-course-name">{{{name}}}</div>
              <div class="ld-course-stat">{{{passed}}} of {{{total}}} passed</div>
            </div>
            <div class="ld-course-bar-wrap">
              <div class="ld-course-bar" style="width:{{{current}}}%"></div>
            </div>
            <span class="ld-course-pct">{{{current}}}%</span>
          </div>
          <div class="ld-course-detail"></div>
        </div>
        {{/progression_courses}}
      </div>
      {{/has_progression}}
      {{^has_progression}}
      <div class="ld-empty"><i class="bi bi-mortarboard"></i><p>No course data available yet</p></div>
      {{/has_progression}}
    </div>
  </div>

  <!-- ===== HOURS SPENT ===== -->
  <div class="ld-card">
    <div class="ld-card-hdr">
      <h3><i class="bi bi-clock-history"></i> Study Hours</h3>
      <span class="ld-card-badge">Current year</span>
    </div>
    <div class="ld-card-body">
      <div id="ldHoursChart" style="height:280px;"></div>
    </div>
  </div>

</div>

<!-- ===== CDN: Highcharts ===== -->
<script src="https://code.highcharts.com/highcharts.js"></script>
<script src="https://code.highcharts.com/modules/exporting.js"></script>
<script src="https://code.highcharts.com/modules/accessibility.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {

    /* ===== HEADER AVATAR ===== */
    var avatarEl = document.querySelector('.ld-avatar');
    if (avatarEl) {
        var n = (avatarEl.getAttribute('data-name') || '').trim();
        avatarEl.textContent = n.charAt(0).toUpperCase();
    }

    /* ===== PROGRESS RING ANIMATION ===== */
    document.querySelectorAll('.ld-ring-fill').forEach(function(c) {
        var pct = parseFloat(c.getAttribute('data-pct')) || 0;
        var r = 52, circ = 2 * Math.PI * r;
        c.style.strokeDasharray = circ;
        c.style.strokeDashoffset = circ;
        setTimeout(function() {
            c.style.transition = 'stroke-dashoffset 1.2s ease';
            c.style.strokeDashoffset = circ - (circ * pct / 100);
        }, 200);
    });

    /* ===== HIGHCHARTS ===== */
    var hoursData = {{{hours_chart_json}}};
    if (typeof Highcharts !== 'undefined') {
        Highcharts.chart('ldHoursChart', {
            chart: { type: 'areaspline', backgroundColor: 'transparent',
                     style: { fontFamily: "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" }},
            title: { text: '' },
            xAxis: { type: 'category', lineColor: '#e5e7eb', tickColor: '#e5e7eb',
                     labels: { style: { color: '#6b7280', fontSize: '11px' }}},
            yAxis: { title: { text: 'Hours', style: { color: '#9ca3af', fontSize: '12px' }},
                     min: 0, gridLineColor: '#f3f4f6',
                     labels: { style: { color: '#9ca3af', fontSize: '11px' }}},
            legend: { enabled: false },
            tooltip: { backgroundColor: '#1f2937', borderWidth: 0, borderRadius: 8,
                       style: { color: '#fff', fontSize: '13px' },
                       pointFormat: '<b>{point.y:.1f}</b> hours' },
            plotOptions: { areaspline: { fillOpacity: 0.15, lineWidth: 3, marker: { radius: 5, lineWidth: 2, lineColor: '#fff' },
                dataLabels: { enabled: true, format: '{point.y:.1f}h',
                    style: { fontSize: '10px', fontWeight: '600', color: '#6b7280', textOutline: 'none' }}}},
            colors: ['#3b82f6'],
            series: [{ name: 'Hours', data: hoursData }],
            credits: { enabled: false },
            exporting: { buttons: { contextButton: { menuItems: ['downloadPNG','downloadPDF'] }}}
        });
    }

    /* ===== EXPANDABLE COURSES ===== */
    function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

    document.querySelectorAll('.ld-course-row').forEach(function(row) {
        row.addEventListener('click', function() {
            var course = this.closest('.ld-course');
            var detail = course.querySelector('.ld-course-detail');
            var icon = this.querySelector('.ld-course-toggle i');
            var isOpen = course.classList.contains('ld-course--open');

            if (!isOpen) {
                try {
                    var items = JSON.parse(course.getAttribute('data-assignments'));
                    var h = '<table class="ld-tbl"><thead><tr><th>Assignment</th><th>Status</th></tr></thead><tbody>';
                    for (var i = 0; i < items.length; i++) {
                        var a = items[i], cls = 'ld-st--none';
                        if (a.status==='Pass') cls='ld-st--pass';
                        else if (a.status==='Refer') cls='ld-st--refer';
                        else if (a.status==='Pending Grading') cls='ld-st--pending';
                        else if (a.status==='Submitted') cls='ld-st--submitted';
                        h += '<tr><td>'+esc(a.name)+'</td><td><span class="ld-st '+cls+'">'+esc(a.status)+'</span></td></tr>';
                    }
                    if (!items.length) h += '<tr><td colspan="2" class="ld-tbl-empty">No assignments</td></tr>';
                    h += '</tbody></table>';
                    detail.innerHTML = h;
                } catch(e) { detail.innerHTML = '<p class="ld-tbl-empty">Unable to load</p>'; }
                course.classList.add('ld-course--open');
                icon.className = 'bi bi-chevron-down';
            } else {
                course.classList.remove('ld-course--open');
                icon.className = 'bi bi-chevron-right';
            }
        });
    });

    /* ===== MESSAGE AVATARS ===== */
    document.querySelectorAll('.ld-msg-avatar').forEach(function(el) {
        var name = el.textContent.trim();
        var parts = name.split(' ');
        var initials = (parts[0]||'').charAt(0) + (parts[1]||'').charAt(0);
        el.textContent = initials.toUpperCase();
        var colors = ['#3b82f6','#8b5cf6','#06b6d4','#f59e0b','#10b981','#ef4444','#ec4899'];
        var hash = 0; for(var i=0;i<name.length;i++) hash = name.charCodeAt(i) + ((hash<<5)-hash);
        el.style.backgroundColor = colors[Math.abs(hash) % colors.length];
    });

});
</script>

<style>
/* ==========================================================================
   LEARNER DASHBOARD — Modern with Depth (ld- namespace)
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

#learner-dashboard *, #learner-dashboard *::before, #learner-dashboard *::after { box-sizing: border-box; }

.ld-shell {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #1e293b;
    max-width: 100%;
    padding: 0;
    -webkit-font-smoothing: antialiased;
    position: relative;
    overflow: hidden;
}

/* ===== DECORATIVE BACKGROUND BLOBS ===== */
.ld-blob {
    position: absolute; border-radius: 50%; pointer-events: none; z-index: 0;
    filter: blur(80px); opacity: 0.5;
}
.ld-blob--1 {
    width: 500px; height: 500px; top: -120px; right: -100px;
    background: radial-gradient(circle, rgba(59,130,246,0.2) 0%, transparent 70%);
}
.ld-blob--2 {
    width: 400px; height: 400px; top: 400px; left: -150px;
    background: radial-gradient(circle, rgba(6,182,212,0.15) 0%, transparent 70%);
}

/* ===== HEADER ===== */
.ld-header {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
    gap: 16px; padding: 32px 36px; margin-bottom: 28px;
    background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #164e63 100%);
    border-radius: 20px;
    box-shadow: 0 8px 32px rgba(15,23,42,0.18);
}
.ld-header-left { display: flex; align-items: center; gap: 16px; }
.ld-avatar {
    width: 56px; height: 56px; border-radius: 16px; display: flex; align-items: center; justify-content: center;
    font-size: 22px; font-weight: 800; color: #fff;
    background: linear-gradient(135deg, #3b82f6, #06b6d4);
    flex-shrink: 0; box-shadow: 0 4px 14px rgba(59,130,246,0.4);
}
.ld-title { font-size: 26px; font-weight: 700; margin: 0; color: #fff; letter-spacing: -0.5px; line-height: 1.2; }
.ld-subtitle { font-size: 14px; color: rgba(255,255,255,0.55); margin: 4px 0 0; font-weight: 400; }
.ld-header-actions { display: flex; gap: 8px; flex-wrap: wrap; }
.ld-btn {
    display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border-radius: 10px;
    font-size: 13px; font-weight: 600; text-decoration: none; transition: all .2s;
    background: rgba(255,255,255,0.12); color: #fff; border: 1px solid rgba(255,255,255,0.15);
    font-family: 'Inter', sans-serif; backdrop-filter: blur(8px);
}
.ld-btn:hover { background: rgba(255,255,255,0.22); border-color: rgba(255,255,255,0.3); color: #fff; text-decoration: none; }
.ld-btn--ghost { background: transparent; border-color: rgba(255,255,255,0.2); color: rgba(255,255,255,0.7); }
.ld-btn--ghost:hover { background: rgba(255,255,255,0.08); color: #fff; }

/* ===== KPI CARDS ===== */
.ld-kpis {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-bottom: 28px;
}
@media (max-width: 1100px) { .ld-kpis { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 600px) { .ld-kpis { grid-template-columns: repeat(2, 1fr); } }

.ld-kpi {
    display: flex; align-items: center; gap: 14px; padding: 22px; border-radius: 16px;
    text-decoration: none; color: inherit;
    transition: all .25s; box-shadow: 0 2px 8px rgba(0,0,0,.06);
    border: 1px solid transparent; position: relative; overflow: hidden;
}
.ld-kpi:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,.12); transform: translateY(-2px);
    text-decoration: none; color: inherit;
}
/* Individual KPI color themes */
.ld-kpi--blue { background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-color: #bfdbfe; }
.ld-kpi--blue .ld-kpi-icon { background: #3b82f6; color: #fff; }
.ld-kpi--blue .ld-kpi-val { color: #1e3a5f; }
.ld-kpi--amber { background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border-color: #fde68a; }
.ld-kpi--amber .ld-kpi-icon { background: #f59e0b; color: #fff; }
.ld-kpi--amber .ld-kpi-val { color: #78350f; }
.ld-kpi--green { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-color: #bbf7d0; }
.ld-kpi--green .ld-kpi-icon { background: #22c55e; color: #fff; }
.ld-kpi--green .ld-kpi-val { color: #14532d; }
.ld-kpi--cyan { background: linear-gradient(135deg, #ecfeff 0%, #cffafe 100%); border-color: #a5f3fc; }
.ld-kpi--cyan .ld-kpi-icon { background: #06b6d4; color: #fff; }
.ld-kpi--cyan .ld-kpi-val { color: #164e63; }
.ld-kpi--purple { background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%); border-color: #e9d5ff; }
.ld-kpi--purple .ld-kpi-icon { background: #8b5cf6; color: #fff; }
.ld-kpi--purple .ld-kpi-val { color: #3b0764; }

.ld-kpi-icon {
    width: 50px; height: 50px; border-radius: 14px; display: flex; align-items: center;
    justify-content: center; font-size: 22px; flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(0,0,0,.15);
    position: relative;
}
.ld-kpi-badge {
    position: absolute; top: -8px; right: -8px;
    min-width: 22px; height: 22px; padding: 0 6px;
    background: #ef4444; color: #fff;
    font-size: 11px; font-weight: 700;
    border-radius: 11px; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 6px rgba(239,68,68,0.5);
    animation: ld-pulse 2s infinite;
}
@keyframes ld-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
}
.ld-kpi-body { display: flex; flex-direction: column; }
.ld-kpi-val { font-size: 30px; font-weight: 800; line-height: 1.1; }
.ld-kpi-val small { font-size: 18px; font-weight: 600; }
