{{!
    @template local_learnerdashboard/dashboard

    Learner Dashboard — personalised overview with progression,
    messages, due dates, KPI cards and hours chart.

    @package   local_learnerdashboard
    @copyright 2026 Epearl Academy
    @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}

<div class="ld-shell" id="learner-dashboard">

  <!-- ===== HEADER BAR ===== -->
  <div class="ld-header">
    <div class="ld-header-inner">
      <div>
        <h1 class="ld-title">My Dashboard</h1>
        <p class="ld-subtitle">Welcome back, {{{fullname}}} &middot; Epearl Academy</p>
      </div>
      <div class="ld-header-actions">
        <a href="{{{mycourses_link}}}" class="ld-hdr-btn">
          <i class="bi bi-journal-bookmark"></i> My Courses
        </a>
        <a href="{{{mail_link}}}" class="ld-hdr-btn">
          <i class="bi bi-envelope"></i> Mail Inbox
        </a>
        <a href="{{{contact_link}}}" class="ld-hdr-btn">
          <i class="bi bi-headset"></i> Contact Support
        </a>
      </div>
    </div>
  </div>

  <!-- ===== KPI CARDS ===== -->
  <div class="ld-kpis">

    <a href="{{{mycourses_link}}}" class="ld-kpi-card ld-kpi-card--link">
      <div class="ld-kpi-top">
        <span class="ld-kpi-icon ld-kpi-icon--courses">
          <i class="bi bi-journal-bookmark-fill"></i>
        </span>
        <span class="ld-kpi-label">Enrolled Courses</span>
      </div>
      <div class="ld-kpi-value">{{{enrolled_courses}}}</div>
    </a>

    <div class="ld-kpi-card ld-kpi-card--amber">
      <div class="ld-kpi-top">
        <span class="ld-kpi-icon ld-kpi-icon--due">
          <i class="bi bi-clock-history"></i>
        </span>
        <span class="ld-kpi-label">Due Assignments</span>
      </div>
      <div class="ld-kpi-value">{{{due_assignments}}}</div>
    </div>

    <div class="ld-kpi-card ld-kpi-card--green">
      <div class="ld-kpi-top">
        <span class="ld-kpi-icon ld-kpi-icon--completed">
          <i class="bi bi-check-circle-fill"></i>
        </span>
        <span class="ld-kpi-label">Completed</span>
      </div>
      <div class="ld-kpi-value">{{{completed_assignments}}}</div>
    </div>

    <div class="ld-kpi-card ld-kpi-card--teal">
      <div class="ld-kpi-top">
        <span class="ld-kpi-icon ld-kpi-icon--progress">
          <i class="bi bi-graph-up-arrow"></i>
        </span>
        <span class="ld-kpi-label">Overall Progress</span>
      </div>
      <div class="ld-kpi-value">{{{overall_progress}}}%</div>
    </div>

    <a href="{{{mail_link}}}" class="ld-kpi-card ld-kpi-card--deep ld-kpi-card--link">
      <div class="ld-kpi-top">
        <span class="ld-kpi-icon ld-kpi-icon--messages">
          <i class="bi bi-envelope-fill"></i>
        </span>
        <span class="ld-kpi-label">Unread Messages</span>
      </div>
      <div class="ld-kpi-value">{{{unread_messages}}}</div>
    </a>

  </div>

  <!-- ===== TWO-COLUMN: DUE DATES + MESSAGES ===== -->
  <div class="ld-two-col">

    <!-- LEFT: Upcoming Due Dates -->
    <div class="ld-panel">
      <div class="ld-panel-hdr">
        <div>
          <h3><i class="bi bi-alarm-fill"></i> Upcoming Due Dates</h3>
          <p>Assignments due within the next 7 days</p>
        </div>
      </div>
      <div class="ld-panel-body">
        {{#has_upcoming_due}}
        <div class="ld-due-list">
          {{#upcoming_due}}
          <a href="{{{assign_link}}}" class="ld-due-item {{#is_red}}ld-due-item--red{{/is_red}}{{#is_amber}}ld-due-item--amber{{/is_amber}}{{#is_green}}ld-due-item--green{{/is_green}}">
            <div class="ld-due-icon">
              <i class="bi bi-file-earmark-text"></i>
            </div>
            <div class="ld-due-content">
              <span class="ld-due-assign">{{{assignname}}}</span>
              <span class="ld-due-course">{{{coursename}}}</span>
              <span class="ld-due-date">{{{duedate}}}</span>
            </div>
            <div class="ld-due-countdown">
              <span class="ld-due-days">{{{days_remaining}}}</span>
              <span class="ld-due-days-label">days</span>
            </div>
          </a>
          {{/upcoming_due}}
        </div>
        {{/has_upcoming_due}}
        {{^has_upcoming_due}}
        <div class="ld-empty-state">
          <i class="bi bi-check2-all"></i>
          <p>No assignments due in the next 7 days</p>
        </div>
        {{/has_upcoming_due}}
      </div>
    </div>

    <!-- RIGHT: Recent Messages -->
    <div class="ld-panel">
      <div class="ld-panel-hdr ld-panel-hdr--alt">
        <div>
          <h3><i class="bi bi-chat-left-text-fill"></i> Recent Messages</h3>
          <p>Latest messages from your tutors</p>
        </div>
      </div>
      <div class="ld-panel-body">
        {{#has_messages}}
        <div class="ld-msg-list">
          {{#recent_messages}}
          <a href="{{{view_link}}}" class="ld-msg-item{{#is_unread}} ld-msg-item--unread{{/is_unread}}">
            <div class="ld-msg-sender">
              <span class="ld-msg-name">{{{sender_name}}}</span>
              {{#is_unread}}<span class="ld-msg-badge">NEW</span>{{/is_unread}}
            </div>
            <div class="ld-msg-subject">{{{subject}}}</div>
            <div class="ld-msg-meta">
              <span class="ld-msg-course"><i class="bi bi-journal-bookmark"></i> {{{coursename}}}</span>
              <span class="ld-msg-time"><i class="bi bi-clock"></i> {{{time_ago}}}</span>
            </div>
          </a>
          {{/recent_messages}}
        </div>
        <div class="ld-msg-footer">
          <a href="{{{mail_link}}}" class="ld-action-link">View All Messages <i class="bi bi-arrow-right"></i></a>
        </div>
        {{/has_messages}}
        {{^has_messages}}
        <div class="ld-empty-state">
          <i class="bi bi-envelope-open"></i>
          <p>No messages yet</p>
        </div>
        {{/has_messages}}
      </div>
    </div>

  </div>

  <!-- ===== MY PROGRESSION ===== -->
  <div class="ld-panel">
    <div class="ld-panel-hdr">
      <div>
        <h3><i class="bi bi-bar-chart-steps"></i> My Progression</h3>
        <p>Overall: {{{overall_progress}}}% &middot; Click a course to see assignment details</p>
      </div>
    </div>
    <div class="ld-panel-body">
      <!-- Overall progress bar -->
      <div class="ld-overall-progress">
        <div class="ld-overall-bar-wrap">
          <div class="ld-overall-bar" style="width:{{{overall_progress}}}%"></div>
        </div>
        <span class="ld-overall-label">{{{overall_progress}}}%</span>
      </div>

      {{#has_progression}}
      <div class="ld-prog-courses">
        {{#progression_courses}}
        <div class="ld-prog-course" data-assignments='{{assignments_json}}'>
          <div class="ld-prog-course-header">
            <span class="ld-prog-toggle"><i class="bi bi-plus-circle"></i></span>
            <span class="ld-prog-course-name">{{{name}}}</span>
            <div class="ld-prog-course-stats">
              <span class="ld-pill">{{{passed}}} / {{{total}}} Passed</span>
              <div class="ld-prog-bar-wrap">
                <div class="ld-prog-bar" style="width:{{{current}}}%"></div>
              </div>
              <span class="ld-prog-bar-label">{{{current}}}%</span>
            </div>
          </div>
          <div class="ld-prog-assignments" style="display:none;"></div>
        </div>
        {{/progression_courses}}
      </div>
      {{/has_progression}}
      {{^has_progression}}
      <div class="ld-empty-state">
        <i class="bi bi-mortarboard"></i>
        <p>No course progression data available</p>
      </div>
      {{/has_progression}}
    </div>
  </div>

  <!-- ===== HOURS SPENT ===== -->
  <div class="ld-panel">
    <div class="ld-panel-hdr ld-panel-hdr--alt">
      <div>
        <h3><i class="bi bi-clock-fill"></i> Hours Spent</h3>
        <p>Monthly learning activity &middot; Current year</p>
      </div>
    </div>
    <div class="ld-panel-body">
      <div id="ldHoursChart" style="height:300px;"></div>
    </div>
  </div>

</div>

<!-- ===== CDN: Highcharts ===== -->
<script src="https://code.highcharts.com/highcharts.js"></script>
<script src="https://code.highcharts.com/modules/exporting.js"></script>
<script src="https://code.highcharts.com/modules/accessibility.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {

    // ===== HIGHCHARTS: Hours Spent =====
    var hoursData = {{{hours_chart_json}}};

    if (typeof Highcharts !== 'undefined') {
        Highcharts.chart('ldHoursChart', {
            chart: {
                type: 'column',
                backgroundColor: 'transparent',
                style: { fontFamily: "'Libre Baskerville', Georgia, serif" }
            },
            title: { text: '' },
            xAxis: { type: 'category' },
            yAxis: {
                title: { text: 'Hours' },
                min: 0
            },
            legend: { enabled: false },
            tooltip: {
                pointFormat: '<b>{point.y:.1f}</b> hours'
            },
            plotOptions: {
                series: {
                    borderWidth: 0,
                    borderRadius: 4,
                    dataLabels: {
                        enabled: true,
                        format: '{point.y:.1f}h',
                        style: { fontSize: '11px', fontWeight: '600' }
                    }
                }
            },
            colors: ['#3a5ba0'],
            series: [{
                name: 'Hours',
                colorByPoint: false,
                data: hoursData
            }],
            credits: { enabled: false },
            exporting: {
                buttons: {
                    contextButton: {
                        menuItems: ['downloadPNG', 'downloadPDF']
                    }
                }
            }
        });
    }

    // ===== EXPANDABLE PROGRESSION =====
    function escHtml(str) {
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(str));
        return d.innerHTML;
    }

    document.querySelectorAll('.ld-prog-course-header').forEach(function(header) {
        header.addEventListener('click', function() {
            var courseEl = this.closest('.ld-prog-course');
            var assignDiv = courseEl.querySelector('.ld-prog-assignments');
            var icon = this.querySelector('.ld-prog-toggle i');

            if (assignDiv.style.display === 'none') {
                try {
                    var assignments = JSON.parse(courseEl.getAttribute('data-assignments'));
                    var html = '<table class="ld-unit-table"><thead><tr><th>Assignment</th><th style="text-align:center">Status</th></tr></thead><tbody>';
                    for (var i = 0; i < assignments.length; i++) {
                        var a = assignments[i];
                        var cls = 'ld-status--notsubmitted';
                        if (a.status === 'Pass') cls = 'ld-status--pass';
                        else if (a.status === 'Refer') cls = 'ld-status--refer';
                        else if (a.status === 'Pending Grading') cls = 'ld-status--pending';
                        else if (a.status === 'Submitted') cls = 'ld-status--submitted';
                        html += '<tr><td>' + escHtml(a.name) + '</td>';
                        html += '<td style="text-align:center"><span class="ld-unit-status ' + cls + '">' + escHtml(a.status) + '</span></td></tr>';
                    }
                    if (assignments.length === 0) {
                        html += '<tr><td colspan="2" style="text-align:center;color:#9ca3af;font-style:italic;padding:16px;">No assignments</td></tr>';
                    }
                    html += '</tbody></table>';
                    assignDiv.innerHTML = html;
                } catch (e) {
                    assignDiv.innerHTML = '<p style="color:#6b7280;text-align:center;padding:12px;">Unable to load assignments</p>';
                }
                assignDiv.style.display = 'block';
                icon.className = 'bi bi-dash-circle';
            } else {
                assignDiv.style.display = 'none';
                icon.className = 'bi bi-plus-circle';
            }
        });
    });

});
</script>

<style>
/* ==========================================================================
   LEARNER DASHBOARD — Editorial Aesthetic (ld- namespace)
   Font: Libre Baskerville | Palette: Deep Blue / Gold / Teal
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap');

#learner-dashboard *,
#learner-dashboard *::before,
#learner-dashboard *::after {
    box-sizing: border-box;
}

.ld-shell {
    font-family: 'Libre Baskerville', Georgia, serif;
    color: #1a2238;
    max-width: 100%;
    padding: 0;
}

/* ==========================================================================
   HEADER
   ========================================================================== */
.ld-header {
    background: linear-gradient(135deg, #1a2238 0%, #3a5ba0 60%, #6ea3c1 100%);
    border-radius: 10px;
    margin-bottom: 28px;
    position: relative;
    overflow: hidden;
}
.ld-header::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -10%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(247,200,115,0.15) 0%, transparent 70%);
    border-radius: 50%;
}
.ld-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 32px;
    position: relative;
    z-index: 1;
    flex-wrap: wrap;
    gap: 16px;
}
.ld-title {
    font-size: 28px;
    font-weight: 700;
    color: #fff;
    margin: 0;
    letter-spacing: -0.5px;
}
.ld-subtitle {
    font-size: 14px;
    color: rgba(255,255,255,0.65);
    margin: 4px 0 0;
    font-style: italic;
}
.ld-header-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}
.ld-hdr-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.12);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.2);
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-family: 'Libre Baskerville', Georgia, serif;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
}
.ld-hdr-btn:hover {
    background: rgba(255,255,255,0.22);
    border-color: rgba(255,255,255,0.4);
    color: #fff;
    text-decoration: none;
}

/* ==========================================================================
   KPI CARDS
   ========================================================================== */
.ld-kpis {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    margin-bottom: 28px;
}
@media (max-width: 1100px) {
    .ld-kpis { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 600px) {
    .ld-kpis { grid-template-columns: 1fr; }
}

.ld-kpi-card {
    background: #fff;
    border: 1px solid #e3eaf2;
    border-radius: 10px;
    padding: 22px 24px 18px;
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
}
.ld-kpi-card::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: #3a5ba0;
}
.ld-kpi-card--amber::after { background: #f7c873; }
.ld-kpi-card--green::after { background: #166534; }
.ld-kpi-card--teal::after { background: #6ea3c1; }
.ld-kpi-card--deep::after { background: linear-gradient(90deg, #3a5ba0, #2d1e2f); }
.ld-kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(26,34,56,0.10);
}

a.ld-kpi-card--link {
    text-decoration: none;
    color: inherit;
    display: block;
    cursor: pointer;
}
a.ld-kpi-card--link:hover {
    text-decoration: none;
    color: inherit;
}

.ld-kpi-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
}
.ld-kpi-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
}
.ld-kpi-icon--courses { background: rgba(58,91,160,0.1); color: #3a5ba0; }
.ld-kpi-icon--due { background: #fef3c7; color: #d97706; }
.ld-kpi-icon--completed { background: #dcfce7; color: #166534; }
.ld-kpi-icon--progress { background: rgba(110,163,193,0.15); color: #0e7490; }
.ld-kpi-icon--messages { background: rgba(58,91,160,0.1); color: #3a5ba0; }

.ld-kpi-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #6b7280;
}
.ld-kpi-value {
    font-size: 38px;
    font-weight: 700;
    color: #1a2238;
    line-height: 1.1;
}

/* ==========================================================================
   TWO-COLUMN LAYOUT
   ========================================================================== */
.ld-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 28px;
}
@media (max-width: 900px) {
    .ld-two-col { grid-template-columns: 1fr; }
}

/* ==========================================================================
   PANELS
   ========================================================================== */
.ld-panel {
    background: #fff;
    border: 1px solid #e3eaf2;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 28px;
}
.ld-two-col .ld-panel {
    margin-bottom: 0;
}
.ld-panel-hdr {
    padding: 20px 28px;
    background: linear-gradient(135deg, #3a5ba0 0%, #6ea3c1 100%);
    color: #fff;
}
.ld-panel-hdr--alt {
    background: linear-gradient(135deg, #1a2238 0%, #3a5ba0 100%);
}
.ld-panel-hdr h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
}
.ld-panel-hdr p {
    margin: 4px 0 0;
    font-size: 13px;
    opacity: 0.8;
    font-style: italic;
}
.ld-panel-body {
    padding: 20px 24px;
}

/* ==========================================================================
   DUE DATES
   ========================================================================== */
.ld-due-list {
    display: flex;
    flex-direction: column;
}
.ld-due-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-bottom: 1px solid #f1f5f9;
    text-decoration: none;
    color: #1a2238;
    transition: background 0.2s;
    position: relative;
    border-left: 4px solid transparent;
}
.ld-due-item:last-child { border-bottom: none; }
.ld-due-item:hover { background: #f8fafc; text-decoration: none; color: #1a2238; }
.ld-due-item--red { border-left-color: #dc2626; }
.ld-due-item--amber { border-left-color: #f7c873; }
.ld-due-item--green { border-left-color: #166534; }

.ld-due-icon {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
    background: rgba(58,91,160,0.08);
    color: #3a5ba0;
}
.ld-due-item--red .ld-due-icon { background: #fee2e2; color: #dc2626; }
.ld-due-item--amber .ld-due-icon { background: #fef3c7; color: #92400e; }

.ld-due-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.ld-due-assign {
    font-size: 13px;
    font-weight: 600;
    color: #1a2238;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}
.ld-due-course {
    font-size: 12px;
    color: #6b7280;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}
.ld-due-date {
    font-size: 11px;
    color: #9ca3af;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.ld-due-countdown {
    text-align: center;
    min-width: 50px;
    flex-shrink: 0;
}
.ld-due-days {
    display: block;
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
}
.ld-due-item--red .ld-due-days { color: #dc2626; }
.ld-due-item--amber .ld-due-days { color: #92400e; }
.ld-due-item--green .ld-due-days { color: #166534; }
.ld-due-days-label {
    font-size: 10px;
    text-transform: uppercase;
    color: #6b7280;
    letter-spacing: 0.5px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

/* ==========================================================================
   MESSAGES
   ========================================================================== */
.ld-msg-list {
    display: flex;
    flex-direction: column;
}
.ld-msg-item {
    display: block;
    padding: 14px 18px;
    border-bottom: 1px solid #f1f5f9;
    text-decoration: none;
    color: #1a2238;
    transition: background 0.2s;
    border-left: 3px solid transparent;
}
.ld-msg-item:last-child { border-bottom: none; }
.ld-msg-item:hover { background: #f8fafc; text-decoration: none; color: #1a2238; }
.ld-msg-item--unread { border-left-color: #3a5ba0; background: rgba(58,91,160,0.03); }

.ld-msg-sender {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
}
.ld-msg-name {
    font-size: 13px;
    font-weight: 700;
    color: #1a2238;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}
.ld-msg-badge {
    display: inline-block;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 20px;
    background: #3a5ba0;
    color: #fff;
    letter-spacing: 0.5px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}
.ld-msg-subject {
    font-size: 13px;
    color: #374151;
    margin-bottom: 6px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.ld-msg-meta {
    display: flex;
    gap: 16px;
    font-size: 11px;
    color: #9ca3af;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}
.ld-msg-meta i {
    margin-right: 3px;
}
.ld-msg-footer {
    padding: 12px 18px;
    text-align: center;
    border-top: 1px solid #f1f5f9;
}
.ld-action-link {
    font-size: 13px;
    font-weight: 600;
