<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/errorlogger/db" VERSION="2026020100"
    COMMENT="XMLDB file for local_errorlogger"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_errorlogger_logs" COMMENT="Error log entries captured by the error logger plugin">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="type" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="error" SEQUENCE="false" COMMENT="error, exception, warning, notice, debug, task_failure, conversion_failure"/>
        <FIELD NAME="severity" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="3" SEQUENCE="false" COMMENT="1=critical, 2=warning, 3=notice, 4=debug"/>
        <FIELD NAME="component" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Plugin or component name"/>
        <FIELD NAME="message" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Error message text"/>
        <FIELD NAME="details" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON: backtrace, file, line, errno, context"/>
        <FIELD NAME="url" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Page URL where error occurred"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="User who triggered the error"/>
        <FIELD NAME="ipaddress" TYPE="char" LENGTH="45" NOTNULL="false" SEQUENCE="false" COMMENT="Client IP address"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_type" UNIQUE="false" FIELDS="type"/>
        <INDEX NAME="idx_severity" UNIQUE="false" FIELDS="severity"/>
        <INDEX NAME="idx_timecreated" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="idx_userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="idx_component" UNIQUE="false" FIELDS="component"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
