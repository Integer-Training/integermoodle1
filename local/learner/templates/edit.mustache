{{!
    @template local_kopere_dashboard/about_dashboard

    Example context (json):
    {
    }
}}
<div class="container-fluid">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
          <li class="breadcrumb-item"><a href="https://epearlacademy.com/my/">Home</a></li>
          <li class="breadcrumb-item"><a href="https://epearlacademy.com/local/learner/view.php">Manage Learners</a></li>
          <li class="breadcrumb-item" aria-current="page" style="margin-top: 6px;">Edit</li>
        </ol>
      </nav>

      <div class="page-header d-flex justify-content-between align-items-center">
        <h2>Edit  {{{fullname}}}</h2>
        <div>
          <button class="back-btn"> <a href="{{{back_url}}}" style="color:#fff;text-decoration: none"><i class="bi bi-arrow-left-short"></i> &nbsp; Learners</a></button>
        </div>
      </div>

      <div class="row bg-light mt-4 p-4 rounded" style="background:linear-gradient(#ecf9f8, #eaf6f4);">
        <div class="col-lg-3 avatar-col">
          <div class="avatar-large" role="img" aria-label="user avatar" style='background: #fff url("https://gecko.atomlms.co.uk/images/avatar.jpg") center/60% no-repeat;border-radius: 100%;'></div>
        </div>

        <div class="col-lg-9">
          <div class="profile-card p-0 shadow-sm">
            <div class="row g-0">
              <div class="col-12 p-3" style="background:#f7fbfb;border-bottom:1px solid rgba(0,0,0,0.04)">
                <div class="row align-items-center">
                  <div class="col-md-8">
                    <p class="mb-1 info-label">Full Name:</p>
                    <div class="h6 mb-0">{{{fullname}}}</div>
                  </div>
                  <div class="col-md-4 text-md-end">
                    <button class="btn login-btn"><a href="{{{login_as}}}" style="color:#fff;text-decoration: none"><i class="bi bi-person-circle"></i>&nbsp; Login As</a></button>
                  </div>
                </div>
              </div>

              <div class="col-12 p-3">
                <div class="row">
                  <div class="col-sm-6">
                    <p class="mb-1 info-label">Username:</p>
                    <div class="text-muted">{{{username}}}</div>
                  </div>
                  <div class="col-sm-6 text-sm-end">
                    <p class="mb-1 info-label">Created:</p>
                    <div class="text-muted">{{{created}}}</div>
                  </div>
                </div>

                <div class="row mt-2">
                  <div class="col-sm-6">
                    <p class="mb-1 info-label">Last Login:</p>
                    <div class="text-muted">{{{last_login}}}</div>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>

        <div class="col-12 mt-4">
          <div class="form-card p-4 rounded">
            <form action="{{{action_url}}}" method="post">
              <div class="row g-3">
                <div class="col-lg-4">
                  <label class="form-label">Title:</label>
                  <select class="form-select">
                    <option>Mrs</option>
                    <option>Mr</option>
                    <option>Ms</option>
                  </select>
                </div>
                <input type="hidden" id="student_id" name="student_id" value="{{{userid}}}">
                <div class="col-lg-4">
                  <label class="form-label">First Name: *</label>
                  <input type="text" name="firstname" class="form-control is-valid" value="{{{firstname}}}" />
                </div>

                <div class="col-lg-4">
                  <label class="form-label">Family Name: *</label>
                  <input type="text" name="lastname"  class="form-control is-valid" value="{{{lastname}}}" />
                </div>

                <div class="col-lg-4">
                  <label class="form-label">Date of Birth:</label>
                  <div class="d-flex">
                    <input type="text" name="dob" class="form-control" value="" />
                  </div>
                </div>

                <div class="col-lg-4">
                  <label class="form-label">Telephone:</label>
                  <input type="text" name="phone1" class="form-control" value="{{{phone}}}" />
                </div>

                  <div class="col-lg-4">
                    <label class="form-label">Email: *</label>
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>
                      <input type="text" name="email" class="form-control is-valid" value="{{{email}}}" />
                    </div>
                  </div>

                  <div class="col-lg-4">
                    <label class="form-label">Gender:</label>
                    <select class="form-select" name="gender"><option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Non-binary">Non-binary</option>
                            <option value="Not Disclosed">Not Disclosed</option>
                    </select>
                  </div>

                  <div class="col-lg-4">
                    <label class="form-label">Ethnicity:</label>
                    <select class="form-select" name="ethnicity"><option value="">Select Ethnicity</option>
                        <option value="44">African</option>                                                          
                        <option value="43">Any other Asian Background</option>
                        <option value="46">Any other Black / African / Caribbean Background</option>
                        <option value="98">Any other ethnic group</option>
                        <option value="38">Any other mixed / multiple ethnic background</option>
                        <option value="34">Any other white background</option>
                        <option value="47">Arab</option>
                        <option value="41">Bangladeshi</option>
                        <option value="45">Caribbean</option>
                        <option value="42">Chinese</option>
                        <option value="39">Indian</option>
                        <option value="99">Not provided</option>
                        <option value="40">Pakistani</option>
                        <option value="37">White and Asian</option>
                    </select>
                  </div>

                  <div class="col-lg-4">
                    <label class="form-label">Has Disability:</label>
                    <select class="form-select" name="disable"><option>No</option><option>Yes</option></select>
                  </div>

              </div>
              <div class="row g-3">
                  <div class="col-12 col-lg-4">
                    <label class="form-label" for="disability">Disability:</label>
                    <select class="form-select select-arrow" id="disability" name="disability" aria-label="Select disability">
                      <option value="">Select Disability</option>
                      <option value="none">None</option>
                      <option value="hearing">Hearing</option>
                    </select>
                  </div>
                  <div class="col-12 col-lg-4">
                    <label class="form-label" for="college_ref">College Ref:</label>
                    <input type="text" id="college_ref" name="college_ref" class="form-control" placeholder="Enter College Ref" />
                  </div>
                  <div class="col-12 col-lg-4">
                    <label class="form-label" for="ni_number">National Insurance Number:</label>
                    <input type="text" id="ni_number" name="ni_number" class="form-control" placeholder="Enter NI Number" />
                  </div>

                  <div class="col-12 col-lg-4">
                    <label class="form-label" for="registration_number">Registration Number:</label>
                    <input type="text" id="registration_number" name="registration_number" class="form-control" placeholder="Enter Registration Number" />
                  </div>
                  <div class="col-12 col-lg-4">
                    <label class="form-label" for="contact_status">Contact Status:</label>
                    <input type="text" id="contact_status" name="contact_status" class="form-control" placeholder="Enter Contact Status" />
                  </div>
                  <div class="col-12 col-lg-4">
                    <label class="form-label" for="aeb_region">AEB Funding Region :</label>
                    <input type="text" id="aeb_region" name="aeb_region" class="form-control" readonly placeholder="AEB Region" />
                  </div>
              </div>

              <hr class="hr-ghost">

          <div class="row">
              <div class="col-lg-7">
                  <div class="row g-3">
                    <div class="col-12 col-md-6">
                      <label class="form-label" for="address1">Address (Line 1):</label>
                      <input type="text" id="address1" name="address1" class="form-control" placeholder="Enter address line 1" />
                    </div>
                    <div class="col-12 col-md-6">
                      <label class="form-label" for="address2">Address (Line 2):</label>
                      <input type="text" id="address2" name="address2" class="form-control" placeholder="Enter address line 2" />
                    </div>

                    <div class="col-12 col-md-6">
                      <label class="form-label" for="town">Town:</label>
                      <input type="text" id="town" name="town" class="form-control" placeholder="Enter town" />
                    </div>
                    <div class="col-12 col-md-6">
                      <label class="form-label" for="county">County:</label>
                      <input type="text" id="county" name="county" class="form-control" placeholder="Enter county" />
                    </div>

                    <div class="col-12 col-md-6">
                      <label class="form-label" for="postcode">Postcode:</label>
                      <input type="text" id="postcode" name="postcode" class="form-control" placeholder="Enter postcode" />
                    </div>
                  </div>
              </div>

                <div class="col-lg-5">
                    <div class="d-flex justify-content-between align-items-center">
                      <div class="section-title">Notes</div>
                    </div>

                    <div class="notes-card p-0 shadow-sm">
                        <div class="table-responsive">
                          <table class="table table-sm mb-0 table-notes">
                            <thead class="table-light">
                              <tr>
                                <th>Note</th>
                                <th>File</th>
                                <th>Created By</th>
                                <th>Date</th>
                                <th>Time</th>
                              </tr>
                            </thead>
                            <tbody>
                              <tr>
                                <td colspan="5" class="text-center text-muted py-4">There are no notes to show</td>
                              </tr>
                            </tbody>
                          </table>
                        </div>

                        <div class="p-3">
                          <textarea id="note_text" name="note_text" class="form-control" rows="8" placeholder="Type your note here..."></textarea>
                          <div class="mt-3 d-flex">
                            <input type="file" id="note_file" name="note_file" class="form-control-file me-2" style="display:none;">
                            <button type="button" class="btn file-btn" onclick="document.getElementById('note_file').click();">Browse for File</button>
                          </div>
                        </div>
                    </div>

                </div>
          </div>

              <div class="section-sep mt-4">
                <div class="d-flex justify-content-between">
                  <div></div>
                  <div>
                    <button type="button" class="btn btn-outline-secondary me-2">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                  </div>
                </div>
              </div>

            </form>
          </div>
        </div>
       <div class="col-12"><h4>Suspend/Unsuspend Log Report</h4></div><br>
       <table style="width:100%">
        <tr>
          <th>Learner Name</th>
          <th>Status</th>
          <th>Action By</th>
          <th>Action Time </th>
        </tr>
        {{# log}}
        <tr>
          <td>{{{learnername}}}</td>
          <td>{{{status}}}</td>
          <td>{{{actionname}}}</td>
          <td>{{{time}}}</td>
        </tr>
        {{/ log}}
   
      </table>
      <br><br>
      <div class="col-12" style="margin-top: 25px;"><h4>Activity Log Report</h4></div><br>
       <table style="width:100%">
        <tr>
          <th>Cours Name</th>
          <th>Activity Name</th>
          <th>Action</th>
          <th>Target </th>
          <th>Log Time</th>
        </tr>
        {{# datalog}}
        <tr>
          <td>{{{coursename}}}</td>
          <td>{{{activityname}}}</td>
          <td>{{{action}}}</td>
          <td>{{{target}}}</td>
          <td>{{{logtime}}}</td>
        </tr>
        {{/ datalog}}
   
      </table>
      </div>
      

  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <style>table, th, td {
    border:1px solid black;
  }
</style>