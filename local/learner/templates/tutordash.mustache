{{!
    @template local_learner/tutordash

    Tutor Dashboard — caseload, grading pipeline, learner activity.
    Design system matches admindash (Editorial Aesthetic — Libre Baskerville / Deep Blue / Gold / Teal).
}}

<div class="td-shell" id="tutor-dashboard">

  <!-- ===== HEADER BAR ===== -->
  <div class="td-header">
    <div class="td-header-inner">
      <div>
        <h1 class="td-title">Tutor Dashboard</h1>
        <p class="td-subtitle">Your caseload overview &middot; Grading pipeline</p>
      </div>
      <div class="td-header-actions">
        <a href="{{{yet_to_grade_url}}}" class="td-hdr-btn">
          <i class="bi bi-journal-check"></i> Marking
        </a>
        <a href="{{{progressions_url}}}" class="td-hdr-btn">
          <i class="bi bi-graph-up-arrow"></i> Progressions
        </a>
        <a href="{{{mycourse_link}}}" class="td-hdr-btn">
          <i class="bi bi-journal-bookmark"></i> My Courses
        </a>
      </div>
    </div>
  </div>

  <!-- ===== SECTION 1: KPI CARDS ===== -->
  <div class="td-kpis">

    <a href="{{{progressions_url}}}" class="td-kpi-card td-kpi-card--link">
      <div class="td-kpi-top">
        <span class="td-kpi-icon td-kpi-icon--learners">
          <i class="bi bi-people-fill"></i>
        </span>
        <span class="td-kpi-label">Your Learners</span>
      </div>
      <div class="td-kpi-value">{{{your_learners}}}</div>
      <div class="td-kpi-chips">
        <span class="td-chip td-chip--green"><i class="bi bi-check-circle-fill"></i> {{{active_count}}} Active</span>
        <span class="td-chip td-chip--red"><i class="bi bi-x-circle-fill"></i> {{{inactive_count}}} Inactive</span>
        <span class="td-chip td-chip--amber"><i class="bi bi-clock-history"></i> {{{created_count}}} Never Logged In</span>
      </div>
    </a>

    <a href="{{{mycourse_link}}}" class="td-kpi-card td-kpi-card--warm td-kpi-card--link">
      <div class="td-kpi-top">
        <span class="td-kpi-icon td-kpi-icon--courses">
          <i class="bi bi-journal-bookmark-fill"></i>
        </span>
        <span class="td-kpi-label">Courses</span>
      </div>
      <div class="td-kpi-value">{{{enrolled_courses}}}</div>
      <div class="td-kpi-chips">
        <span class="td-chip td-chip--slate"><i class="bi bi-list-check"></i> {{{total_assignments}}} Assignments</span>
      </div>
    </a>

    <a href="{{{yet_to_grade_url}}}" class="td-kpi-card td-kpi-card--cool td-kpi-card--link">
      <div class="td-kpi-top">
        <span class="td-kpi-icon td-kpi-icon--marking">
          <i class="bi bi-clipboard2-check-fill"></i>
        </span>
        <span class="td-kpi-label">Awaiting Marking</span>
      </div>
      <div class="td-kpi-value">{{{yet_to_grade}}}</div>
      <div class="td-kpi-chips">
        <span class="td-chip td-chip--teal"><i class="bi bi-arrow-repeat"></i> {{{resubmissions}}} Resubmissions</span>
      </div>
    </a>

    <div class="td-kpi-card td-kpi-card--deep">
      <div class="td-kpi-top">
        <span class="td-kpi-icon td-kpi-icon--grading">
          <i class="bi bi-patch-check-fill"></i>
        </span>
        <span class="td-kpi-label">Grading Stats</span>
      </div>
      <div class="td-kpi-value">{{{graded}}}<span class="td-kpi-value-sub">graded</span></div>
      <div class="td-kpi-chips">
        <span class="td-chip td-chip--green"><i class="bi bi-trophy-fill"></i> {{{pass_rate}}}% Pass Rate</span>
        <span class="td-chip td-chip--slate"><i class="bi bi-hourglass-split"></i> {{{avg_turnaround}}}d Avg Turn.</span>
      </div>
    </div>

  </div>

  <!-- ===== ALERT CARDS (below KPIs) ===== -->
  <div class="td-alerts">

    <a href="{{{overdue_url}}}" class="td-alert td-alert--danger">
      <div class="td-alert-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
      <div class="td-alert-content">
        <span class="td-alert-label">Overdue (>72h Ungraded)</span>
        <span class="td-alert-value">{{{overdue_assigns}}}</span>
      </div>
      <i class="bi bi-arrow-right td-alert-arrow"></i>
    </a>

    <a href="{{{imm_url}}}" class="td-alert td-alert--warning">
      <div class="td-alert-icon"><i class="bi bi-alarm"></i></div>
      <div class="td-alert-content">
        <span class="td-alert-label">Due Within 3 Days</span>
        <span class="td-alert-value">{{{imm_assigns}}}</span>
      </div>
      <i class="bi bi-arrow-right td-alert-arrow"></i>
    </a>

    <a href="{{{inactive_learners_link}}}" class="td-alert td-alert--info">
      <div class="td-alert-icon"><i class="bi bi-person-slash"></i></div>
      <div class="td-alert-content">
        <span class="td-alert-label">Inactive Learners (30+ days)</span>
        <span class="td-alert-value">{{{inactive_count}}}</span>
      </div>
      <i class="bi bi-arrow-right td-alert-arrow"></i>
    </a>

    <a href="{{{draft_feedback_url}}}" class="td-alert td-alert--draft">
      <div class="td-alert-icon"><i class="bi bi-file-earmark-text"></i></div>
      <div class="td-alert-content">
        <span class="td-alert-label">Awaiting Draft Feedback</span>
        <span class="td-alert-value">{{{draft_feedback_count}}}</span>
      </div>
      <i class="bi bi-arrow-right td-alert-arrow"></i>
    </a>

    <a href="{{{ai_checks_url}}}" class="td-alert td-alert--ai">
      <div class="td-alert-icon"><i class="bi bi-robot"></i></div>
      <div class="td-alert-content">
        <span class="td-alert-label">AI Check Tool</span>
        <span class="td-alert-value" style="font-size:14px;">Upload &amp; Check</span>
      </div>
      <i class="bi bi-arrow-right td-alert-arrow"></i>
    </a>

  </div>

  <!-- ===== SECTION 2: CHARTS ===== -->
  <div class="td-charts">

    <div class="td-chart-card">
      <div class="td-chart-hdr">
        <i class="bi bi-pie-chart-fill"></i>
        <span>Learner Activity Distribution</span>
      </div>
      <div id="tdLearnerPieChart" class="td-chart-body"></div>
    </div>

    <div class="td-chart-card">
      <div class="td-chart-hdr td-chart-hdr--alt">
        <i class="bi bi-bar-chart-line-fill"></i>
        <span>Grading Outcomes &middot; Pass Rate {{{pass_rate}}}%</span>
      </div>
      <div id="tdOutcomesChart" class="td-chart-body"></div>
    </div>

  </div>

  <!-- ===== SECTION 3: GRADING PIPELINE ===== -->
  <div class="td-panel">
    <div class="td-panel-hdr">
      <div>
        <h3><i class="bi bi-funnel-fill"></i> Grading Pipeline</h3>
        <p>Submissions awaiting action, overdue, and imminent deadlines</p>
      </div>
    </div>
    <div class="td-panel-body">
      <table class="td-table" style="width:100%">
        <thead>
          <tr>
            <th>Metric</th>
            <th>Count</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="td-cell-name"><i class="bi bi-hourglass-split" style="color:#3a5ba0;"></i> Awaiting Marking (First Submissions)</td>
            <td class="text-center"><span class="td-pill td-pill--blue">{{{yet_to_grade}}}</span></td>
            <td class="text-center"><a href="{{{yet_to_grade_url}}}" class="td-action-link">View <i class="bi bi-arrow-right"></i></a></td>
          </tr>
          <tr>
            <td class="td-cell-name"><i class="bi bi-arrow-repeat" style="color:#92400e;"></i> Resubmissions Awaiting Review</td>
            <td class="text-center"><span class="td-pill td-pill--amber">{{{resubmissions}}}</span></td>
            <td class="text-center"><a href="{{{resubmissions_url}}}" class="td-action-link">View <i class="bi bi-arrow-right"></i></a></td>
          </tr>
          <tr>
            <td class="td-cell-name"><i class="bi bi-exclamation-triangle-fill" style="color:#dc2626;"></i> Overdue (>72h Ungraded)</td>
            <td class="text-center"><span class="td-pill td-pill--red">{{{overdue_assigns}}}</span></td>
            <td class="text-center"><a href="{{{overdue_url}}}" class="td-action-link">View <i class="bi bi-arrow-right"></i></a></td>
          </tr>
          <tr>
            <td class="td-cell-name"><i class="bi bi-alarm-fill" style="color:#6ea3c1;"></i> Due Within 3 Days</td>
            <td class="text-center"><span class="td-pill td-pill--teal">{{{imm_assigns}}}</span></td>
            <td class="text-center"><a href="{{{imm_url}}}" class="td-action-link">View <i class="bi bi-arrow-right"></i></a></td>
          </tr>
          <tr>
            <td class="td-cell-name"><i class="bi bi-check2-all" style="color:#166534;"></i> Total Graded (All Time)</td>
            <td class="text-center"><span class="td-pill td-pill--green">{{{graded}}}</span></td>
            <td class="text-center"></td>
          </tr>
          <tr>
            <td class="td-cell-name"><i class="bi bi-file-earmark-text" style="color:#9C27B0;"></i> Awaiting Draft Feedback</td>
            <td class="text-center"><span class="td-pill td-pill--purple">{{{draft_feedback_count}}}</span></td>
            <td class="text-center"><a href="{{{draft_feedback_url}}}" class="td-action-link">View <i class="bi bi-arrow-right"></i></a></td>
          </tr>
          <tr>
            <td class="td-cell-name"><i class="bi bi-robot" style="color:#6ea3c1;"></i> AI Check Tool</td>
            <td class="text-center"><span class="td-pill td-pill--teal">Tool</span></td>
            <td class="text-center"><a href="{{{ai_checks_url}}}" class="td-action-link">Open <i class="bi bi-arrow-right"></i></a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ===== SECTION 4: PROGRAMMES & CASELOAD ===== -->
  <div class="td-panel">
    <div class="td-panel-hdr td-panel-hdr--alt">
      <div>
        <h3><i class="bi bi-journal-bookmark-fill"></i> Programmes &amp; Caseload</h3>
        <p>Your assigned courses and learner distribution</p>
      </div>
    </div>
    <div class="td-panel-body">
      <table class="td-table" style="width:100%">
        <thead>
          <tr>
            <th>Programme</th>
            <th>Learners</th>
          </tr>
        </thead>
        <tbody>
          {{#courses}}
          <tr>
            <td class="td-cell-name">{{{coursename}}}</td>
            <td class="text-center">
              <a href="{{{users_link}}}" class="td-pill td-pill--blue" style="text-decoration:none;">{{{caseload}}}</a>
            </td>
          </tr>
          {{/courses}}
          {{^courses}}
          <tr>
            <td colspan="2" style="text-align:center;color:#6b7280;padding:24px;font-style:italic;">No programmes assigned</td>
          </tr>
          {{/courses}}
        </tbody>
      </table>
    </div>
  </div>

  <!-- ===== SECTION 5: NEWS & UPDATES ===== -->
  <div class="td-panel">
    <div class="td-panel-hdr" style="background: linear-gradient(135deg, #1a2238 0%, #3a5ba0 100%);">
      <div>
        <h3><i class="bi bi-megaphone-fill"></i> News &amp; Updates</h3>
        <p>Stay informed about platform changes</p>
      </div>
      {{#has_news}}<a href="{{{news_link}}}" class="td-hdr-btn" style="margin-left:auto;"><i class="bi bi-arrow-right"></i> View All</a>{{/has_news}}
    </div>
    <div class="td-panel-body" style="padding: 0;">
      {{#has_news}}
      {{#recent_news}}
      <a href="{{{view_url}}}" class="td-news-item{{#is_unread}} td-news-item--unread{{/is_unread}}">
        <div class="td-news-left">
          <div class="td-news-title">
            {{#is_important}}<i class="bi bi-exclamation-triangle-fill" style="color:#dc2626;margin-right:6px;"></i>{{/is_important}}
            {{{title}}}
          </div>
          <div class="td-news-meta">
            <span class="td-news-cat {{{category_class}}}">{{{category}}}</span>
            <span style="color:#94a3b8;margin:0 6px;">&middot;</span>
            <span style="color:#6b7280;">{{{formatted_date}}}</span>
          </div>
        </div>
        <div class="td-news-right">
          {{#is_unread}}<span class="td-news-badge td-news-badge--unread">New</span>{{/is_unread}}
          {{^is_unread}}
            {{#requires_ack}}
              {{#is_acknowledged}}<span class="td-news-badge td-news-badge--ack"><i class="bi bi-check-circle"></i></span>{{/is_acknowledged}}
              {{^is_acknowledged}}<span class="td-news-badge td-news-badge--pending">Action</span>{{/is_acknowledged}}
            {{/requires_ack}}
          {{/is_unread}}
        </div>
      </a>
      {{/recent_news}}
      {{/has_news}}
      {{^has_news}}
      <div style="text-align:center;padding:40px 24px;color:#6b7280;font-style:italic;">
        <i class="bi bi-megaphone" style="font-size:32px;color:#cbd5e1;display:block;margin-bottom:10px;"></i>
        No news or updates at the moment
      </div>
      {{/has_news}}
    </div>
  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {

    // ===== HIGHCHARTS: Learner Activity Pie =====
    Highcharts.chart('tdLearnerPieChart', {
        chart: {
            type: 'pie',
            backgroundColor: 'transparent',
            style: { fontFamily: "'Libre Baskerville', Georgia, serif" }
        },
        title: { text: '' },
        tooltip: { pointFormat: '{series.name}: <b>{point.percentage:.1f}%</b> ({point.y})' },
        accessibility: { point: { valueSuffix: '%' } },
        plotOptions: {
            pie: {
                allowPointSelect: true,
                cursor: 'pointer',
                borderWidth: 2,
                borderColor: '#ffffff',
                dataLabels: {
                    enabled: true,
                    format: '<b>{point.name}</b>: {point.y}',
                    style: { fontSize: '12px', fontWeight: '400', color: '#3c4257' }
                },
                showInLegend: true
            }
        },
        legend: {
            itemStyle: { fontSize: '12px', fontWeight: '400', color: '#3c4257' }
        },
        colors: ['#3a5ba0', '#2d1e2f', '#f7c873', '#b0b8c1'],
        series: [{
            name: 'Learners',
            colorByPoint: true,
            data: [
                { name: 'Active', y: {{active_count}}, sliced: true, selected: true },
                { name: 'Inactive (30+ days)', y: {{inactive_count}} },
                { name: 'Never Logged In', y: {{created_count}} },
                { name: 'Suspended', y: {{suspended_count}} }
            ]
        }],
        credits: { enabled: false }
    });

    // ===== HIGHCHARTS: Grading Outcomes Pie =====
    Highcharts.chart('tdOutcomesChart', {
        chart: {
            type: 'pie',
            backgroundColor: 'transparent',
            style: { fontFamily: "'Libre Baskerville', Georgia, serif" }
        },
        title: { text: '' },
        tooltip: { pointFormat: '{series.name}: <b>{point.percentage:.1f}%</b> ({point.y})' },
        accessibility: { point: { valueSuffix: '%' } },
        plotOptions: {
            pie: {
                innerSize: '55%',
                allowPointSelect: true,
                cursor: 'pointer',
                borderWidth: 2,
                borderColor: '#ffffff',
                dataLabels: {
                    enabled: true,
                    format: '<b>{point.name}</b>: {point.y}',
                    style: { fontSize: '12px', fontWeight: '400', color: '#3c4257' }
                },
                showInLegend: true
            }
        },
        legend: {
            itemStyle: { fontSize: '12px', fontWeight: '400', color: '#3c4257' }
        },
        colors: ['#3a5ba0', '#f7c873'],
        series: [{
            name: 'Grades',
            colorByPoint: true,
            data: [
                { name: 'Pass', y: {{pass_count}}, sliced: true, selected: true },
                { name: 'Refer', y: {{refer_count}} }
            ]
        }],
        credits: { enabled: false }
    });

});
</script>

<style>
/* ==========================================================================
   TUTOR DASHBOARD — Editorial Aesthetic (matches Admin Dashboard)
   Font: Libre Baskerville | Palette: Deep Blue / Gold / Teal
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap');

/* --- Reset within dashboard scope --- */
#tutor-dashboard *,
#tutor-dashboard *::before,
#tutor-dashboard *::after {
    box-sizing: border-box;
}

.td-shell {
    font-family: 'Libre Baskerville', Georgia, serif;
    color: #1a2238;
    max-width: 100%;
    padding: 0;
}

/* ==========================================================================
   HEADER
   ========================================================================== */
.td-header {
    background: linear-gradient(135deg, #1a2238 0%, #3a5ba0 60%, #6ea3c1 100%);
    border-radius: 10px;
    margin-bottom: 28px;
    position: relative;
    overflow: hidden;
}
.td-header::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -10%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(247,200,115,0.15) 0%, transparent 70%);
    border-radius: 50%;
}
.td-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 32px;
    position: relative;
    z-index: 1;
    flex-wrap: wrap;
    gap: 16px;
}
.td-title {
    font-size: 28px;
    font-weight: 700;
    color: #fff;
    margin: 0;
    letter-spacing: -0.5px;
}
.td-subtitle {
    font-size: 14px;
    color: rgba(255,255,255,0.65);
    margin: 4px 0 0;
    font-style: italic;
}
.td-header-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}
.td-hdr-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.12);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.2);
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-family: 'Libre Baskerville', Georgia, serif;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
}
.td-hdr-btn:hover {
    background: rgba(255,255,255,0.22);
    border-color: rgba(255,255,255,0.4);
    color: #fff;
    text-decoration: none;
}

/* ==========================================================================
   KPI CARDS — 4 across using CSS grid
   ========================================================================== */
.td-kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 28px;
}
@media (max-width: 1100px) {
    .td-kpis { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
    .td-kpis { grid-template-columns: 1fr; }
}

.td-kpi-card {
    background: #fff;
    border: 1px solid #e3eaf2;
    border-radius: 10px;
    padding: 22px 24px 18px;
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
}
.td-kpi-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #3a5ba0;
}
.td-kpi-card--warm::after { background: #f7c873; }
.td-kpi-card--cool::after { background: #6ea3c1; }
.td-kpi-card--deep::after { background: linear-gradient(90deg, #3a5ba0, #2d1e2f); }

.td-kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(26,34,56,0.10);
}
a.td-kpi-card--link {
    text-decoration: none;
    color: inherit;
    display: block;
    cursor: pointer;
}
a.td-kpi-card--link:hover {
    text-decoration: none;
    color: inherit;
}
.td-kpi-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
}
.td-kpi-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
}
.td-kpi-icon--learners { background: rgba(58,91,160,0.1); color: #3a5ba0; }
.td-kpi-icon--courses { background: rgba(247,200,115,0.2); color: #92400e; }
.td-kpi-icon--marking { background: rgba(110,163,193,0.15); color: #0e7490; }
.td-kpi-icon--grading { background: rgba(45,30,47,0.08); color: #2d1e2f; }

.td-kpi-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #6b7280;
}
.td-kpi-value {
    font-size: 38px;
    font-weight: 700;
    color: #1a2238;
    line-height: 1.1;
    margin-bottom: 10px;
}
.td-kpi-value-sub {
    font-size: 14px;
    font-weight: 400;
    color: #6b7280;
    margin-left: 6px;
    letter-spacing: 0;
}
.td-kpi-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}
.td-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    padding: 3px 10px;
    border-radius: 20px;
    white-space: nowrap;
}
.td-chip--green { background: #dcfce7; color: #166534; }
.td-chip--slate { background: #f1f5f9; color: #475569; }
.td-chip--amber { background: #fef3c7; color: #92400e; }
.td-chip--red { background: #fee2e2; color: #991b1b; }
.td-chip--teal { background: #ccfbf1; color: #115e59; }

/* ==========================================================================
   CHARTS — 2-up grid
   ========================================================================== */
.td-charts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 28px;
}
@media (max-width: 900px) {
    .td-charts { grid-template-columns: 1fr; }
}

.td-chart-card {
    background: #fff;
